---
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import GoogleTag from '../../../components/GoogleTag.astro';
import '../../../styles/blog.css';

const title = 'Zerodha Kite & Coin AI Features: AI PM Case Study';
const description =
  'AI features for Zerodha Kite & Coin: a design-thinking case study with personas, RICE prioritization, feature specs, and success criteria.';

const pdfUrl = '/case-studies/zerodha-kite-coin-ai-features-case-study.pdf';
const pdfName = 'Zerodha-Kite-Coin-AI-Features-Case-Study-Bedanta-Gogoi.pdf';
const blogUrl = '/blog/ai-features-zerodha-kite-coin-smarter-investing/';

const stats = [
  { value: '2', label: 'User personas' },
  { value: '5', label: 'Core problems' },
  { value: '13', label: 'AI ideas scored' },
  { value: '5', label: 'Features specced' },
];

const steps = [
  { id: 'context', label: 'Context' },
  { id: 'empathize', label: 'Empathize' },
  { id: 'define', label: 'Define' },
  { id: 'ideate', label: 'Ideate' },
  { id: 'features', label: 'Specify' },
  { id: 'test', label: 'Test' },
];

const productLine = [
  { name: 'Kite', role: 'Active trading & delivery stock buying', focus: true },
  { name: 'Coin', role: 'Mutual fund investing', focus: true },
  { name: 'Console', role: 'Portfolio, reporting & analytics' },
  { name: 'Kite Connect', role: 'APIs & developer ecosystem' },
  { name: 'Varsity', role: 'Investor education' },
  { name: 'Zerodha Capital', role: 'Lending & credit' },
  { name: 'Zerodha Fund House', role: 'Asset management' },
];

const revenue = [
  {
    q: 'Who pays?',
    a: 'Zerodha’s customers — primarily active traders, investors using demat services, MTF users, API users, and customers using paid or value-added services.',
  },
  {
    q: 'What’s paid?',
    a: 'Brokerage, DP charges, MTF interest, AMC, API subscriptions, and fees for certain value-added services.',
  },
  {
    q: 'For what?',
    a: 'Executing trades, maintaining demat accounts, borrowing funds through MTF, accessing paid APIs and data, and using premium services.',
  },
  {
    q: 'How?',
    a: 'Per-order transaction charges, recurring account and service fees, interest on funded MTF amounts, and subscription fees.',
  },
];

const pricing = [
  { value: '₹0', label: 'Equity delivery' },
  { value: '₹20', label: 'or 0.03% per order — intraday & futures' },
  { value: '₹20', label: 'per executed order — options' },
  { value: '0.04%', label: 'per day on MTF-funded amount' },
  { value: '₹500', label: 'per month per Kite Connect API key' },
];

const personas = [
  {
    initial: 'M',
    name: 'Manish',
    role: 'Product Manager',
    meta: '32 · Married, 1 child · ₹35 LPA',
    frustration:
      'Has invested in mutual funds since his first job eight years ago. With a stagnant market and negative returns, he is unsure about continuing — and is considering swing trading.',
    behaviour: 'Checks his portfolio size and volatility every week.',
    goal: '₹2 crore for an apartment, his child’s education, and a car.',
  },
  {
    initial: 'R',
    name: 'Rohan',
    role: 'Trader',
    meta: '40 · Married, 2 children · ₹20 LPA',
    frustration:
      'Constant regulatory change — he recently lost ₹2 lakh after a new SEBI market-closing-price rule.',
    behaviour: 'A seasoned trader of 10 years who studies the market on weekends and in his spare time.',
    goal: 'Turn his proprietorship trading firm into a private limited company with a friend, offering broking, asset management, research and stock recommendations.',
  },
];

const problems = [
  {
    title: 'Portfolio understanding',
    body: 'Investors can see holdings and returns but struggle with the bigger picture: diversification, concentration, sector exposure and overlapping mutual-fund holdings.',
    persona: 'Manish',
    evidence: 'Holds three flexi-cap funds, each with 7%+ allocated to HDFC Bank.',
  },
  {
    title: 'Trading behaviour',
    body: 'Active traders may not recognise when their trading becomes excessive or unusually risky, especially after losses — a real concern given the risks of retail F&O trading.',
    persona: 'Manish',
    evidence: 'Is considering swing trading after weak mutual-fund returns.',
  },
  {
    title: 'Investment research',
    body: 'Turning filings, results, annual reports and announcements into useful insight takes time and expertise.',
    persona: 'Rohan',
    evidence: 'His career is built on trading, not fundamental research.',
  },
  {
    title: 'Customer support',
    body: 'Customers frequently need help with account, order, margin, charge and transaction issues, creating support workload and delays.',
    persona: 'Rohan',
    evidence: 'Paid ₹5 lakh after an income-tax notice for an incorrectly filed ITR, following informal advice from a relative.',
  },
  {
    title: 'Long-term investment planning',
    body: 'Coin investors can run SIPs across multiple funds but lack personalised visibility into whether their behaviour matches their goals.',
    persona: 'Rohan',
    evidence: 'Sees trading as his income source and has no long-term investments.',
  },
];

// RICE = Reach (lakh users) × Impact × Confidence ÷ Effort, sorted by score.
const rice = [
  { name: 'Portfolio Health & Risk Analyzer', reach: '20L', impact: 3, confidence: '90%', effort: 8, score: 6.75 },
  { name: 'Fundamental Research Copilot', reach: '15L', impact: 3, confidence: '85%', effort: 8, score: 4.78 },
  { name: 'Financial Concept Explainer', reach: '20L', impact: 1, confidence: '95%', effort: 4, score: 4.75 },
  { name: 'Portfolio Overlap Detector', reach: '12L', impact: 3, confidence: '90%', effort: 7, score: 4.63 },
  { name: 'Earnings & Filing Summarizer', reach: '12L', impact: 2, confidence: '90%', effort: 5, score: 4.32 },
  { name: 'Financial & Tax Education Assistant', reach: '25L', impact: 2, confidence: '90%', effort: 12, score: 3.75 },
  { name: '“Teach Me This Stock”', reach: '10L', impact: 2, confidence: '90%', effort: 5, score: 3.6 },
  { name: 'P&L / Tax Report Interpreter', reach: '12L', impact: 2, confidence: '90%', effort: 6, score: 3.6 },
  { name: 'Portfolio Explainability Copilot', reach: '15L', impact: 3, confidence: '80%', effort: 10, score: 3.6 },
  { name: 'Company Comparison', reach: '8L', impact: 2, confidence: '85%', effort: 5, score: 2.72 },
  { name: 'Trading Behaviour Coach', reach: '8L', impact: 3, confidence: '80%', effort: 8, score: 2.4 },
  { name: 'Wealth & Goal Coach', reach: '10L', impact: 3, confidence: '70%', effort: 10, score: 2.1 },
  { name: 'Trading vs Investing Coach', reach: '8L', impact: 2, confidence: '75%', effort: 6, score: 2.0 },
];
const maxScore = rice[0].score;

const features = [
  {
    name: 'Portfolio Health & Risk Analyzer',
    problem: 'Investors can see their returns but may not understand how diversified or risky their overall portfolio is.',
    ai: ['Rule-based', 'Statistical ML', 'Generative AI'],
    data: 'Kite holdings, Coin MF holdings, transactions, portfolio history, stock/fund holdings, sector and market data',
    improves: 'Helps users understand the overall health and risk of their portfolio',
    money: 'Paid or freemium feature — one free check per quarter',
    metrics: ['Portfolio review frequency', 'Customer LTV'],
  },
  {
    name: 'Fundamental Research Copilot',
    problem: 'Rohan knows how to trade but struggles to analyse companies from a fundamental and financial perspective.',
    ai: ['RAG', 'Generative AI', 'Text analysis'],
    data: 'Annual reports, financial statements, earnings calls, exchange filings, investor presentations, corporate announcements, financial ratios',
    improves: 'Makes fundamental research faster and easier; improves investment understanding',
    money: 'Paid insights tier based on research usage',
    metrics: ['Research adoption', 'Research time', 'Sessions per user'],
  },
  {
    name: 'Financial Concept Explainer',
    problem: 'Users may know how to trade but struggle to understand complex financial and tax concepts.',
    ai: ['RAG', 'Generative AI'],
    data: 'Zerodha help articles, Varsity content, official SEBI/NSE/BSE information, tax rules and regulatory documentation',
    improves: 'Improves financial literacy and reduces dependence on informal or inaccurate advice',
    money: 'Reduces support cost while improving customer trust, engagement and retention',
    metrics: ['Support tickets', 'Support cost per customer', 'Self-service resolution'],
  },
  {
    name: 'Portfolio Overlap Detector',
    problem: 'Manish owns three flexi-cap funds but doesn’t realise they overlap significantly, including 7%+ exposure to HDFC Bank in each.',
    ai: ['Rule-based', 'Statistical analysis'],
    data: 'Mutual-fund portfolio holdings, Kite holdings, stock weights, sector classifications, historical holdings',
    improves: 'Surfaces hidden stock and fund overlap for a more accurate picture of diversification',
    money: 'Bundled with a premium plan',
    metrics: ['Overlap detection', 'Portfolio review frequency', 'Feature usage'],
  },
  {
    name: 'Earnings & Filing Summarizer',
    problem: 'Investors struggle to understand what has changed in earnings reports and regulatory filings, and why it matters.',
    ai: ['Text analysis', 'Generative AI'],
    data: 'Quarterly results, annual reports, exchange filings, earnings-call transcripts, investor presentations, corporate announcements',
    improves: 'Reduces information overload and the time needed to understand company updates',
    money: 'Freemium feature',
    metrics: ['Time-to-insight', 'Feature adoption', 'Engagement', 'Retention'],
  },
];

const tests = [
  {
    name: 'Portfolio Health & Risk Analyzer',
    what: 'Users can understand the overall health, concentration and risk of their portfolio.',
    metrics: ['Portfolio understanding', 'Task completion rate', 'Time-to-insight', 'Usefulness score'],
    criteria: ['≥80% correctly identify their biggest portfolio risk', '≥20% reduction in time-to-insight', '≥4/5 usefulness score'],
  },
  {
    name: 'Fundamental Research Copilot',
    what: 'Users understand a company’s fundamentals faster, without manually analysing multiple documents.',
    metrics: ['Research completion time', 'Research accuracy'],
    criteria: ['≥30% reduction in research time', '≥90% factual accuracy', '≥95% of material claims supported by source documents'],
  },
  {
    name: 'Earnings & Filing Summarizer',
    what: 'Users can identify what matters most in lengthy earnings reports and filings.',
    metrics: ['Time-to-insight', 'Summary accuracy', 'Feature adoption'],
    criteria: ['≥90% accuracy in identifying material information'],
  },
  {
    name: 'Portfolio Overlap Detector',
    what: 'Users realise that owning multiple funds does not necessarily mean they are diversified.',
    metrics: ['Overlap comprehension', 'Detection accuracy', 'Task completion rate', 'User trust'],
    criteria: ['≥80% correctly identify significant overlap', '≥80% correctly understand their effective exposure', '≥4/5 trust score'],
  },
  {
    name: 'Financial Concept Explainer',
    what: 'Users understand complex financial and tax concepts more easily than through traditional help content.',
    metrics: ['Comprehension score', 'Time-to-understanding', 'Follow-up questions', 'Self-service resolution rate'],
    criteria: ['≥80% correctly explain the concept after using it', '≥30% reduction in time-to-understanding', '≥20% reduction in related support queries'],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.aipmbedanta.com/projects/zerodha-kite-coin-ai-features/" />
    <meta property="og:site_name" content="aipmbedanta" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI Features for Zerodha Kite & Coin — design thinking case study" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/projects/zerodha-kite-coin-ai-features/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell article-shell cs-shell">
      <SiteNav current="about" />

      <article class="article">
        <a class="back-link" href="/projects/">← Back to Projects</a>

        <header class="article-header cs-hero">
          <p class="cs-eyebrow">Case Study · Fintech · Design Thinking</p>
          <h1>AI Features for Zerodha Kite &amp; Coin</h1>
          <p>
            Where AI can help traders and long-term investors — taken from user personas to
            prioritized, testable feature specs.
          </p>

          <div class="cs-actions">
            <a class="cs-btn cs-btn--primary" href={pdfUrl} download={pdfName}>
              Download Case Study <span aria-hidden="true">↓</span>
            </a>
            <a class="cs-btn cs-btn--ghost" href={blogUrl}>
              Read the full write-up <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="cs-file-meta">PDF · 6 pages · 342 KB · includes prototype screens</p>

          <dl class="cs-stats">
            {
              stats.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))
            }
          </dl>
        </header>

        <nav class="cs-steps" aria-label="Case study sections">
          <ol>
            {
              steps.map((s, i) => (
                <li>
                  <a href={`#${s.id}`}>
                    <span class="cs-step-num">{String(i + 1).padStart(2, '0')}</span>
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="article-body cs-body">
          <!-- 01 · CONTEXT -->
          <section id="context" class="cs-section">
            <p class="cs-kicker">01 · Context</p>
            <h2>Picking the Product</h2>
            <p class="cs-lead">
              I mapped Zerodha’s product line and focused on <strong>Kite</strong> and
              <strong>Coin</strong>, which serve two very different users: active traders and
              long-term investors.
            </p>

            <ul class="cs-products">
              {
                productLine.map((p) => (
                  <li class:list={{ focus: p.focus }}>
                    <span class="cs-product-name">
                      {p.name}
                      {p.focus && <span class="cs-badge">Focus</span>}
                    </span>
                    <span class="cs-product-role">{p.role}</span>
                  </li>
                ))
              }
            </ul>

            <div class="cs-grid-2">
              <div class="cs-card">
                <h3>Kite users</h3>
                <ul class="cs-ticks">
                  <li>Active traders</li>
                  <li>Intraday and F&amp;O traders</li>
                  <li>Investors who trade occasionally</li>
                </ul>
              </div>
              <div class="cs-card">
                <h3>Coin users</h3>
                <ul class="cs-ticks">
                  <li>Long-term mutual-fund investors</li>
                  <li>SIP investors</li>
                  <li>Investors building wealth over many years</li>
                </ul>
              </div>
            </div>

            <h3 class="cs-subhead">Understanding the revenue model</h3>
            <div class="cs-grid-2">
              {
                revenue.map((r) => (
                  <div class="cs-card cs-qa">
                    <h4>{r.q}</h4>
                    <p>{r.a}</p>
                  </div>
                ))
              }
            </div>
            <div class="cs-card cs-pricing">
              <h4>How much? <span>Retail pricing at the time of the analysis</span></h4>
              <ul>
                {
                  pricing.map((p) => (
                    <li>
                      <strong>{p.value}</strong>
                      <span>{p.label}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </section>

          <!-- 02 · EMPATHIZE -->
          <section id="empathize" class="cs-section">
            <p class="cs-kicker">02 · Empathize</p>
            <h2>User Personas</h2>
            <div class="cs-grid-2">
              {
                personas.map((p) => (
                  <div class="cs-card cs-persona">
                    <div class="cs-persona-head">
                      <span class="cs-avatar" aria-hidden="true">{p.initial}</span>
                      <div>
                        <h3>
                          {p.name} <span>· {p.role}</span>
                        </h3>
                        <p class="cs-persona-meta">{p.meta}</p>
                      </div>
                    </div>
                    <dl>
                      <dt>Fear / frustration</dt>
                      <dd>{p.frustration}</dd>
                      <dt>Behaviour</dt>
                      <dd>{p.behaviour}</dd>
                      <dt>Goal</dt>
                      <dd>{p.goal}</dd>
                    </dl>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- 03 · DEFINE -->
          <section id="define" class="cs-section">
            <p class="cs-kicker">03 · Define</p>
            <h2>Five Core Problems</h2>
            <div class="cs-problems">
              {
                problems.map((p, i) => (
                  <div class="cs-card cs-problem">
                    <span class="cs-problem-num">{i + 1}</span>
                    <h3>{p.title}</h3>
                    <p>{p.body}</p>
                    <p class="cs-evidence">
                      <span class="cs-tag">{p.persona}</span>
                      {p.evidence}
                    </p>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- 04 · IDEATE -->
          <section id="ideate" class="cs-section">
            <p class="cs-kicker">04 · Ideate</p>
            <h2>Solutions and RICE Prioritization</h2>
            <p class="cs-lead">
              I generated 13 AI feature ideas and scored each with RICE —
              <strong>Reach</strong> (lakh users) × <strong>Impact</strong> ×
              <strong>Confidence</strong> ÷ <strong>Effort</strong>. The top five moved forward to
              specification.
            </p>
            <div class="cs-table-wrap">
              <table class="cs-rice">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Solution</th>
                    <th>Reach</th>
                    <th>Impact</th>
                    <th>Conf.</th>
                    <th>Effort</th>
                    <th class="cs-score-col">RICE score</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    rice.map((row, i) => (
                      <tr class:list={{ top: i < 5 }}>
                        <td>{i + 1}</td>
                        <td>
                          {row.name}
                          {i < 5 && <span class="cs-badge">Top 5</span>}
                        </td>
                        <td>{row.reach}</td>
                        <td>{row.impact}</td>
                        <td>{row.confidence}</td>
                        <td>{row.effort}</td>
                        <td class="cs-score-col">
                          <span class="cs-bar">
                            <span style={`width: ${(row.score / maxScore) * 100}%`} />
                          </span>
                          <strong>{row.score.toFixed(2)}</strong>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </section>

          <!-- 05 · SPECIFY -->
          <section id="features" class="cs-section">
            <p class="cs-kicker">05 · Specify</p>
            <h2>The Top 5 AI Features</h2>
            <div class="cs-features">
              {
                features.map((f, i) => (
                  <div class="cs-card cs-feature">
                    <div class="cs-feature-head">
                      <span class="cs-feature-num">{String(i + 1).padStart(2, '0')}</span>
                      <h3>{f.name}</h3>
                    </div>
                    <p class="cs-feature-problem">{f.problem}</p>
                    <div class="cs-chips" aria-label="Type of AI">
                      {f.ai.map((t) => (
                        <span class="cs-chip cs-chip--ai">{t}</span>
                      ))}
                    </div>
                    <dl>
                      <dt>Data needed</dt>
                      <dd>{f.data}</dd>
                      <dt>What it improves</dt>
                      <dd>{f.improves}</dd>
                      <dt>How Zerodha benefits</dt>
                      <dd>{f.money}</dd>
                      <dt>Metrics it will impact</dt>
                      <dd>
                        <div class="cs-chips">
                          {f.metrics.map((m) => (
                            <span class="cs-chip">{m}</span>
                          ))}
                        </div>
                      </dd>
                    </dl>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- 06 · TEST -->
          <section id="test" class="cs-section">
            <p class="cs-kicker">06 · Test</p>
            <h2>Validating Usefulness</h2>
            <p class="cs-lead">
              Each feature gets a clear hypothesis, the metrics to watch, and a pass/fail bar set
              before testing begins.
            </p>
            <div class="cs-grid-2 cs-tests">
              {
                tests.map((t) => (
                  <div class="cs-card cs-test">
                    <h3>{t.name}</h3>
                    <p class="cs-test-what">{t.what}</p>
                    <div class="cs-chips">
                      {t.metrics.map((m) => (
                        <span class="cs-chip">{m}</span>
                      ))}
                    </div>
                    <ul class="cs-criteria">
                      {t.criteria.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="cs-section cs-outro">
            <p>
              <strong>My focus:</strong> product and revenue-model analysis, user personas, problem
              definition, AI opportunity ideation, RICE prioritization, AI feature specification,
              prototyping, and success-criteria design.
            </p>

            <div class="cs-cta-band">
              <div>
                <h3>Want the full case study?</h3>
                <p>Download the PDF with the prototype screens, or read the deeper write-up covering AI architecture, product risks, and a rollout plan.</p>
              </div>
              <div class="cs-actions">
                <a class="cs-btn cs-btn--primary" href={pdfUrl} download={pdfName}>
                  Download Case Study <span aria-hidden="true">↓</span>
                </a>
                <a class="cs-btn cs-btn--ghost" href={blogUrl}>
                  Read the write-up <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </section>
        </div>
      </article>
    </main>

    <SiteFooter />
  </body>

  <style>
    /* Wider canvas than a regular article: this page is mostly cards and tables. */
    .cs-shell {
      max-width: 1040px;
    }

    .cs-body {
      max-width: none;
      padding-top: 8px;
    }

    .cs-body p {
      max-width: 760px;
    }

    html {
      scroll-behavior: smooth;
    }

    /* ── HERO ─────────────────────────────── */
    .cs-hero {
      padding-bottom: 36px;
    }

    .cs-eyebrow {
      margin: 22px 0 0 !important;
      color: var(--accent) !important;
      font-size: 0.74rem !important;
      font-weight: 700 !important;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .cs-hero h1 {
      margin-top: 10px;
    }

    .cs-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .cs-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: 100px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: box-shadow 0.3s ease, transform 0.2s ease, background 0.2s ease;
    }

    .cs-btn:hover {
      transform: translateY(-2px);
      text-decoration: none;
    }

    .cs-btn--primary {
      background: linear-gradient(130deg, #3457d1 0%, #0083a8 100%);
      box-shadow: 0 8px 28px rgba(79, 142, 255, 0.28);
      color: #fff;
    }

    .cs-btn--primary:hover {
      color: #fff;
      box-shadow: 0 16px 48px rgba(79, 142, 255, 0.4);
    }

    .cs-btn--ghost {
      border: 1px solid var(--border);
      background: var(--glass-bg);
      color: var(--text);
    }

    .cs-btn--ghost:hover {
