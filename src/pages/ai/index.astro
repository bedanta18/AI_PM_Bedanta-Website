---
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '../../styles/blog.css';

const CATEGORY = 'AI';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.ispublished && post.data.categories.includes(CATEGORY))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> Free AI resource for Product & Marketing Teams</title>
    <meta
      name="description"
      content="AI concepts, tools, and how AI is changing product and marketing work. Free articles on AI product management, AI agents, LLMs & AI tools."
    />
    <meta
      name="keywords"
      content="AI, AI concepts, AI tools, AI product management, AI PM, LLM, RAG, AI agents, applied AI, core AI PM, bedanta gogoi, aipmbedanta"
    />
    <meta property="og:title" content="AI for Product & Marketing Teams | aipmbedanta." />
    <meta
      property="og:description"
      content="AI concepts, tools, and how AI is changing product and marketing work. Free articles on AI product management, AI agents, LLMs & AI tools."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="aipmbedanta. — Product Management, Marketing, Growth & AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/ai/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="ai" />

      <header class="blog-hero">
        <p class="eyebrow">Category</p>
        <h1>AI</h1>
        <p>AI concepts, tools, and how AI is changing product and marketing work.</p>
      </header>

      <section class="post-grid" aria-label="AI articles">
        {
          posts.map((post) => (
            <article class="post-card">
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span>{post.data.author}</span>
              </div>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{post.data.desc}</p>
              <a class="read-link" href={`/blog/${post.id}/`}>
                Read <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </section>
      {posts.length === 0 && <p class="no-results">No posts in this category yet.</p>}

      <section class="explore-more" aria-label="More AI resources">
        <h2>Explore More</h2>
        <div class="explore-grid">
          <a class="explore-card" href="/ai-concepts/">
            <h3>AI Concepts</h3>
            <p>A growing glossary of AI concepts and terminology — LLMs, tokenization, RAG, agents, reasoning models, and more.</p>
          </a>
          <a class="explore-card" href="/ai-tools/">
            <h3>AI &amp; Marketing Tools</h3>
            <p>A curated toolkit of AI and marketing tools — ChatGPT, Claude, SEMrush, HubSpot, and more — used to build products and ship campaigns.</p>
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .explore-more {
    padding: 56px 0 8px;
    margin-top: 48px;
    border-top: 1px solid var(--border);
  }

  .explore-more h2 {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .explore-card {
    display: block;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .explore-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 131, 168, 0.3);
    box-shadow: 0 20px 44px rgba(18, 26, 46, 0.08);
  }

  .explore-card h3 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .explore-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .explore-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
