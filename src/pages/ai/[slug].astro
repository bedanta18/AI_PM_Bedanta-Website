---
import { getCollection, render } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { SITE_URL, DEFAULT_ARTICLE_IMAGE } from '../../lib/seo';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', (post) => post.data.ispublished);
  const posts = allPosts.filter((post) => post.data.categories.includes('AI'));

  return posts.map((post) => {
    const pinned = (post.data.relatedSlugs ?? [])
      .map((slug) => posts.find((p) => p.id === slug))
      .filter((p) => p !== undefined && p.id !== post.id);

    const autoRelated = posts
      .filter(
        (p) =>
          p.id !== post.id &&
          !pinned.some((pin) => pin.id === p.id) &&
          p.data.categories.some((c) => post.data.categories.includes(c))
      )
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    const related = [...pinned, ...autoRelated].slice(0, 3);

    return {
      params: { slug: post.id },
      props: { post, related },
    };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const seoTitle = post.data.metaTitle ?? post.data.title;
const seoDescription = post.data.metaDescription ?? post.data.desc;
const canonicalUrl = `${SITE_URL}/ai/${post.id}/`;

const breadcrumbItems = [
  { name: 'Home', url: `${SITE_URL}/` },
  { name: 'AI', url: `${SITE_URL}/ai/` },
  { name: post.data.title, url: canonicalUrl },
];

const categoryHref: Record<string, string> = {
  'Product Management': '/product-management/',
  Marketing: '/marketing/',
  Growth: '/growth/',
  AI: '/ai/',
};

const formatShortDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    {post.data.keywords.length > 0 && (
      <meta name="keywords" content={post.data.keywords.join(', ')} />
    )}
    <meta name="author" content={post.data.author} />
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:author" content={post.data.author} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="aipmbedanta" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bedanta Gogoi — Product Manager" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <ArticleSchema
      headline={post.data.title}
      description={seoDescription}
      url={canonicalUrl}
      datePublished={post.data.date}
      dateModified={post.data.updated}
      authorName={post.data.author}
      image={DEFAULT_ARTICLE_IMAGE}
      articleSection="AI"
      keywords={post.data.keywords}
    />
    <BreadcrumbSchema items={breadcrumbItems} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell article-shell">
      <SiteNav current="ai" />

      <article class="article">
        <a class="back-link" href="/ai/">Back to AI</a>
        <header class="article-header">
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span>{post.data.author}</span>
          </div>
          <h1>{post.data.title}</h1>
          <p>{post.data.desc}</p>
          <div class="chip-row">
            {post.data.categories.map((category) =>
              categoryHref[category] ? (
                <a href={categoryHref[category]}>{category}</a>
              ) : (
                <span>{category}</span>
              )
            )}
          </div>
        </header>
        <div class="article-body">
          <Content />
        </div>

        {related.length > 0 && (
          <section class="explore-more" aria-label="Related articles">
            <h2>Related Articles</h2>
            <div class="explore-grid">
              {related.map((r) => (
                <a class="explore-card" href={`/ai/${r.id}/`}>
                  <h3>{r.data.title}</h3>
                  <p>{r.data.desc}</p>
                  <p class="explore-date">{formatShortDate(r.data.date)}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </main>

    <SiteFooter />
  </body>
</html>
