---
import { getCollection } from 'astro:content';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GoogleTag from '../components/GoogleTag.astro';

const allPosts = (await getCollection('blog')).filter((post) => post.data.ispublished);
const latestPosts = [...allPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 6);
const totalPosts = allPosts.length;

const pmConcepts = (await getCollection('pmConcepts')).filter((c) => c.data.ispublished);
const aiConceptsList = (await getCollection('aiConcepts')).filter((c) => c.data.ispublished);
const totalConcepts = pmConcepts.length + aiConceptsList.length;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);

const categories = [
  {
    name: 'Product Management',
    href: '/product-management/',
    desc: 'Frameworks, case studies, and field notes on building products people love.',
    size: 'lg',
    icon: '<path d="M12 3l9 5-9 5-9-5 9-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 13l9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 18l9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    name: 'Marketing',
    href: '/marketing/',
    desc: 'Strategy, positioning, and execution for modern marketing teams.',
    size: 'wide',
    icon: '<path d="M3 10v4a1 1 0 0 0 1 1h2l1 5h2l-1-5h1l9 4V6l-9 4H4a1 1 0 0 0-1 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M19 9.5a3.5 3.5 0 0 1 0 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  {
    name: 'Growth',
    href: '/growth/',
    desc: 'Activation, retention, PLG, and the metrics that move the needle.',
    size: 'sm',
    icon: '<path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    name: 'AI',
    href: '/ai/',
    desc: 'AI concepts, tools, and how AI is changing product and marketing work.',
    size: 'sm',
    icon: '<path d="M12 3l1.8 4.9L19 9.7l-5.2 1.8L12 16.4l-1.8-4.9L5 9.7l5.2-1.8L12 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M19 15l.9 2.4L22 18.3l-2.1.9L19 21.6l-.9-2.4L16 18.3l2.1-.9L19 15Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>',
  },
];

const categoryPostCounts: Record<string, number> = Object.fromEntries(
  categories.map((c) => [c.name, allPosts.filter((p) => p.data.categories.includes(c.name)).length])
);

const catAccent: Record<string, string> = {
  'Product Management': 'var(--a1)',
  Marketing: 'var(--a3)',
  Growth: 'var(--a2)',
  AI: 'var(--grad)',
};
---

