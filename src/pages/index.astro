        <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="/resources/" class="btn btn-s">Browse Free Resources</a>
    </div>
    <div class="hero-stats sr">
      <div class="stat-chip glass tilt">
        <span class="stat-num" data-countup={totalPosts}>0</span><span class="stat-plus">+</span>
        <span class="stat-label">Articles</span>
      </div>
      <div class="stat-chip glass tilt">
        <span class="stat-num" data-countup="4">0</span>
        <span class="stat-label">Core Topics</span>
      </div>
      <div class="stat-chip glass tilt">
        <span class="stat-num" data-countup={totalConcepts}>0</span><span class="stat-plus">+</span>
        <span class="stat-label">Concepts Explained</span>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORY BENTO GRID -->
<section class="sec">
  <div class="max">
    <div class="sec-blob" style="width:480px;height:480px;top:-80px;right:-160px;background:radial-gradient(circle,rgba(0,131,168,.08) 0%,transparent 70%)"></div>
    <div class="sr">
      <div class="sec-label">Categories</div>
      <h2 class="sec-title">Explore by Topic</h2>
      <p class="sec-sub">Four focus areas covering the full surface of building and growing products.</p>
    </div>
    <div class="bento-grid">
      {categories.map((cat, i) => (
        <a class={`bento-card glass tilt sr b-${cat.size}`} href={cat.href} style={`transition-delay:${i * 60}ms`}>
          <div class="bento-top">
            <span class="bento-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={cat.icon} /></span>
            {categoryPostCounts[cat.name] > 0 && (
              <span class="bento-count">{categoryPostCounts[cat.name]}+ articles</span>
            )}
          </div>
          <div class="bento-bottom">
            <h3>{cat.name}</h3>
            <p>{cat.desc}</p>
            <span class="cat-arrow">
              Explore
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FEATURED ARTICLES -->
<section class="sec sec-alt">
  <div class="max">
    <div class="sr">
      <div class="sec-label">From the Blog</div>
      <h2 class="sec-title">Latest Articles</h2>
    </div>
    <div class="article-grid">
      {latestPosts.map((post, i) => (
        <a class="article-card glass tilt sr" href={`/blog/${post.id}/`} style={`transition-delay:${i * 60}ms`}>
