  <div class="orb orb2"></div>
  <div class="orb orb3"></div>
  <div class="spotlight"></div>
  <div class="hero-inner">
    <span class="hero-badge glass"><span class="dot"></span>Product · Marketing · Growth · AI</span>
    <h1 class="hero-name">Your go-to resource for <span class="grad-name">Product Management, Marketing, Growth &amp; AI</span></h1>
    <p class="hero-desc">Practical frameworks, field-tested templates, and clear explanations — for modern product and growth professionals.</p>
    <div class="hero-actions">
      <a href="/blog/" class="btn btn-p magnetic">
