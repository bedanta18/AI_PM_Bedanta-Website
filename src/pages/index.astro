---
import { getCollection } from 'astro:content';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GoogleTag from '../components/GoogleTag.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { projects } from '../data/projects';
import '../styles/blog.css';

const allPosts = (await getCollection('blog'))
  .filter((post) => post.data.ispublished)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = allPosts.slice(0, 6);
const terminalPosts = allPosts.slice(0, 4);
const totalPosts = allPosts.length;

const pmConcepts = (await getCollection('pmConcepts')).filter((c) => c.data.ispublished);
const aiConceptsList = (await getCollection('aiConcepts')).filter((c) => c.data.ispublished);
const totalConcepts = pmConcepts.length + aiConceptsList.length;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);

const isoDay = (date: Date) => date.toISOString().slice(0, 10);

const categories = [
  {
    name: 'Product Management',
    href: '/product-management/',
    desc: 'Frameworks, case studies, and field notes on building products people love.',
    size: 'lg',
    topics: ['Strategy', 'Discovery', 'Metrics', 'Frameworks', 'Case Studies', 'Interviews'],
    icon: '<path d="M12 3l9 5-9 5-9-5 9-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 13l9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 18l9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  },
  {
    name: 'AI',
    href: '/ai/',
    desc: 'AI concepts, tools, and how AI is changing product and marketing work.',
    size: 'wide',
    icon: '<path d="M12 3l1.8 4.9L19 9.7l-5.2 1.8L12 16.4l-1.8-4.9L5 9.7l5.2-1.8L12 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M19 15l.9 2.4L22 18.3l-2.1.9L19 21.6l-.9-2.4L16 18.3l2.1-.9L19 15Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>',
  },
  {
    name: 'Marketing',
    href: '/marketing/',
    desc: 'Strategy, positioning, and execution for modern marketing teams.',
    size: 'sm',
    icon: '<path d="M3 10v4a1 1 0 0 0 1 1h2l1 5h2l-1-5h1l9 4V6l-9 4H4a1 1 0 0 0-1 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M19 9.5a3.5 3.5 0 0 1 0 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
  {
    name: 'Growth',
    href: '/growth/',
    desc: 'Activation, retention, PLG, and the metrics that move the needle.',
    size: 'sm',
    icon: '<path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];

const categoryPostCounts: Record<string, number> = Object.fromEntries(
  categories.map((c) => [c.name, allPosts.filter((p) => p.data.categories.includes(c.name)).length])
);
---

<!DOCTYPE html>
<html lang="en">
<head>
<GoogleTag />
<ThemeInit />
<script is:inline type="text/javascript">(function(i,m,p,a,c,t){c.ire_o=p;c[p]=c[p]||function(){(c[p].a=c[p].a||[]).push(arguments)};t=a.createElement(m);var z=a.getElementsByTagName(m)[0];t.async=1;t.src=i;z.parentNode.insertBefore(t,z)})('https://utt.impactcdn.com/P-A7720025-0239-45f9-ad2a-c0128b3e129f1.js','script','impactStat',document,window);impactStat('transformLinks');impactStat('trackImpression');</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Free Resources for Product Management, Marketing, Growth & AI</title>
<meta name="title"       content="Free Resources for Product Management, Marketing, Growth & AI">
<meta name="description" content="A free content hub for Product Management, Marketing, Growth & AI, featuring practical frameworks, field-tested templates, and clear explanations.">
<meta name="keywords"    content="product management, product manager, AI product management, AI PM, marketing frameworks, growth strategy, product led growth, product roadmap, GTM strategy, user research, marketing strategy, SWOT analysis, Porter's five forces, BCG matrix, 4Ps of marketing, SEO strategy, AI concepts, LLM, RAG, AI agents, free PM templates, PRD template, OKR tracker, bedanta gogoi, aipmbedanta">
<meta name="author"      content="Bedanta Gogoi">
<meta name="robots"      content="index, follow">
<meta property="og:type"        content="website">
<meta property="og:title"       content="Free Resources for Product Management, Marketing, Growth & AI">
<meta property="og:description" content="A free content hub for Product Management, Marketing, Growth & AI, featuring practical frameworks, field-tested templates, and clear explanations.">
<meta property="og:url"         content="https://www.aipmbedanta.com/">
<meta property="og:image"        content="https://www.aipmbedanta.com/og-image.png">
<meta property="og:image:width"  content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt"    content="Free Resources for Product Management, Marketing, Growth & AI">
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content="Free Resources for Product Management, Marketing, Growth & AI">
<meta name="twitter:description" content="A free content hub for Product Management, Marketing, Growth & AI, featuring practical frameworks, field-tested templates, and clear explanations.">
<meta name="twitter:image"       content="https://www.aipmbedanta.com/og-image.png">
<link rel="canonical" href="https://www.aipmbedanta.com/">
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Free Resources for Product Management, Marketing, Growth & AI",
  "url": "https://www.aipmbedanta.com/",
  "datePublished": "2026-06-21",
  "dateModified": "2026-09-18",
  "author": {
    "@type": "Person",
    "name": "Bedanta Gogoi"
  }
})} />
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>

<SiteNav current="home" />

<main>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">Product · Marketing · Growth · AI</p>
      <h1>
        Your go-to resource for
        <span class="grad-text">Product Management, Marketing, Growth &amp; AI</span>
      </h1>
      <p class="hero-desc">
        Practical frameworks, field-tested templates, and clear explanations — for modern product
        and growth professionals.
      </p>
      <div class="hero-actions">
        <a href="/blog/" class="btn btn-primary">
          Explore articles
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/resources/" class="btn btn-ghost">Browse free resources</a>
      </div>
      <dl class="hero-stats">
        <div><dt>Articles</dt><dd>{totalPosts}+</dd></div>
        <div><dt>Core topics</dt><dd>4</dd></div>
        <div><dt>Concepts explained</dt><dd>{totalConcepts}+</dd></div>
      </dl>
    </div>

    <div class="terminal" aria-label="Latest articles">
      <div class="terminal-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="terminal-path">~/aipmbedanta/latest</span>
        <span class="live"><span aria-hidden="true"></span>live</span>
      </div>
      <ol class="terminal-list">
        {terminalPosts.map((post, i) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="t-idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="t-body">
                <span class="t-meta">
                  <span class="t-tag">{post.data.categories[0] ?? 'Article'}</span>
                  <time datetime={post.data.date.toISOString()}>{isoDay(post.data.date)}</time>
                </span>
                <span class="t-title">{post.data.title}</span>
              </span>
              <span class="t-go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="terminal-foot" href="/blog/">
        <span class="prompt">$</span> ls articles/ <span class="t-count">— {totalPosts} files</span>
        <span class="caret" aria-hidden="true"></span>
      </a>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="sec wrap" aria-labelledby="topics-title">
    <div class="sec-head">
      <p class="section-label">Categories</p>
      <h2 id="topics-title">Explore by topic</h2>
      <p>Four focus areas covering the full surface of building and growing products.</p>
    </div>
    <div class="bento">
      {categories.map((cat) => (
        <a class={`bento-card b-${cat.size}`} href={cat.href}>
          <div class="bento-top">
            <span class="bento-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={cat.icon} /></span>
            {categoryPostCounts[cat.name] > 0 && (
              <span class="bento-count">{categoryPostCounts[cat.name]} articles</span>
            )}
          </div>
          {cat.topics && (
            <ul class="bento-topics" aria-label={`${cat.name} topics`}>
              {cat.topics.map((t) => <li>{t}</li>)}
            </ul>
          )}
          <div>
            <h3>{cat.name}</h3>
            <p>{cat.desc}</p>
            <span class="read-link">Explore <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST -->
  <section class="sec wrap" aria-labelledby="latest-title">
    <div class="sec-head sec-head--row">
      <div>
        <p class="section-label">From the blog</p>
        <h2 id="latest-title">Latest articles</h2>
      </div>
      <a class="btn btn-ghost" href="/blog/">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="post-grid">
      {latestPosts.map((post) => (
        <article class="post-card">
          <div class="post-meta">
            <span class="post-tag">{post.data.categories[0] ?? 'Article'}</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </div>
          <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.desc}</p>
          <span class="read-link">Read <span aria-hidden="true">→</span></span>
        </article>
      ))}
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="sec wrap" aria-labelledby="projects-title">
    <div class="sec-head sec-head--row">
      <div>
        <p class="section-label">Built &amp; shipped</p>
        <h2 id="projects-title">AI projects</h2>
      </div>
      <a class="btn btn-ghost" href="/projects/">All projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="project-row">
      {projects.map((p) => (
        <a class="project-tile" href={`/projects/${p.slug}/`}>
          {p.image ? (
            <img src={p.image} alt={p.imageAlt ?? ''} loading="lazy" />
          ) : (
            <div class="project-ph" aria-hidden="true"><span>{p.coverLabel ?? p.title.split(' — ')[0]}</span></div>
          )}
          <div class="project-body">
            <h3>{p.title}</h3>
            <ul class="project-tags">
              {p.tags.slice(0, 3).map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- LIBRARY -->
  <section class="sec wrap" aria-labelledby="library-title">
    <div class="sec-head">
      <p class="section-label">Library</p>
      <h2 id="library-title">References &amp; templates</h2>
    </div>
    <div class="library">
      <a class="lib-card" href="/pm-concepts/">
        <span class="lib-num">{pmConcepts.length}+</span>
        <span class="lib-name">PM Concepts</span>
        <span class="lib-desc">A growing glossary of core product management frameworks.</span>
      </a>
      <a class="lib-card" href="/ai-concepts/">
        <span class="lib-num">{aiConceptsList.length}+</span>
        <span class="lib-name">AI Concepts</span>
        <span class="lib-desc">AI terms explained clearly for product and growth teams.</span>
      </a>
      <a class="lib-card lib-card--accent" href="/resources/">
        <span class="lib-num">13</span>
        <span class="lib-name">Free templates</span>
        <span class="lib-desc">For PMs, marketers, and growth teams. Browse resources →</span>
      </a>
    </div>
  </section>

  <!-- AUTHOR -->
  <section class="sec wrap author-sec">
    <div class="author">
      <div class="avatar" aria-hidden="true">BG</div>
      <div class="author-text">
        <p class="author-name">Bedanta Gogoi</p>
        <p class="author-bio">Product Manager with 6+ years across SaaS, Quick Commerce, and PropTech — writing about building AI products.</p>
      </div>
      <a href="/about/" class="btn btn-ghost">About me <span aria-hidden="true">→</span></a>
    </div>
  </section>
</main>

<SiteFooter />

<style>
  .wrap {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* ── HERO ─────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    padding: 148px 0 72px;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.3rem, 4.4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.048em;
    text-wrap: balance;
  }

  .grad-text {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-desc {
    max-width: 540px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 40px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }

  .hero-stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .hero-stats dt {
    color: var(--quiet);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-stats dd {
    margin: 0 0 2px;
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Terminal panel */
  .terminal {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-lg), 0 0 120px -40px var(--halo-1);
    overflow: hidden;
  }

  .terminal::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(140deg, color-mix(in srgb, var(--accent) 60%, transparent), transparent 35%, transparent 65%, color-mix(in srgb, var(--accent-2) 60%, transparent));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--quiet);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--surface-strong);
    border: 1px solid var(--border-strong);
  }

  .terminal-path {
    flex: 1;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
  }

  .live span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
    50% { box-shadow: 0 0 0 5px transparent; }
  }

  .terminal-list {
    margin: 0;
    padding: 6px;
    list-style: none;
  }

  .terminal-list a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: start;
    padding: 14px 12px;
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .terminal-list a:hover {
    background: var(--surface-strong);
  }

  .t-idx {
    padding-top: 2px;
    color: var(--quiet);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .t-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .t-meta {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--quiet);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .t-tag {
    color: var(--accent-text);
  }

  .t-title {
    font-size: 0.96rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .t-go {
    padding-top: 2px;
    color: var(--quiet);
    transition: transform 0.25s var(--ease), color 0.2s ease;
  }

  .terminal-list a:hover .t-go {
    color: var(--accent-text);
    transform: translateX(3px);
  }

  .terminal-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .prompt {
    color: var(--accent-text);
  }

  .t-count {
    color: var(--quiet);
  }

  .caret {
    width: 7px;
    height: 15px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* ── SECTIONS ─────────────────────── */
  .sec {
    padding: 72px 0;
  }

  .sec-head {
    margin-bottom: 32px;
  }

  .sec-head--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .sec-head h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .sec-head p:not(.section-label) {
    max-width: 520px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .sec .post-grid {
    padding-top: 0;
  }

  /* ── BENTO ────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(190px, auto);
    gap: 16px;
  }

  .bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 26px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.35s var(--ease);
  }

  .bento-card::after {
    content: '';
    position: absolute;
    inset: auto -20% -60% auto;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--halo-1), transparent 65%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .bento-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .bento-card:hover::after {
    opacity: 1;
  }

  .b-lg {
    grid-column: span 2;
    grid-row: span 2;
    padding: 32px;
    background:
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--card-bg);
  }

  .b-wide {
    grid-column: span 2;
  }

  .bento-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .bento-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-strong);
    color: var(--accent-text);
  }

  .bento-count {
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .bento-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bento-topics li {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elev);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .bento-card h3 {
    margin: 0 0 6px;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .b-lg h3 {
    font-size: 1.9rem;
  }

  .bento-card p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* ── PROJECTS ─────────────────────── */
  .project-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .project-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.35s var(--ease);
  }

  .project-tile:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .project-tile img,
  .project-ph {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--border);
  }

  .project-ph {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 30%, var(--halo-1), transparent 60%),
      radial-gradient(circle at 75% 70%, var(--halo-2), transparent 60%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--bg-elev);
  }

  .project-ph span {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .project-body {
    padding: 22px 24px 24px;
  }

  .project-body h3 {
    margin: 0 0 14px;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-tags li {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.76rem;
  }

  /* ── LIBRARY ──────────────────────── */
  .library {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .lib-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.35s var(--ease);
  }

  .lib-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .lib-num {
    font-family: var(--font-mono);
    font-size: 2.6rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .lib-name {
    margin-top: 10px;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .lib-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .lib-card--accent {
    border-color: transparent;
    background: var(--accent);
    box-shadow: var(--glow);
    color: var(--accent-ink);
  }

  .lib-card--accent .lib-desc {
    color: color-mix(in srgb, var(--accent-ink) 72%, transparent);
  }

  .lib-card--accent:hover {
    border-color: transparent;
  }

  /* ── AUTHOR ───────────────────────── */
  .author-sec {
    padding-bottom: 104px;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
  }

  .avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .author-text {
    flex: 1;
    min-width: 0;
  }

  .author-name {
    margin: 0 0 3px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .author-bio {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* ── RESPONSIVE ───────────────────── */
  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 128px;
    }

    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .b-lg {
      grid-row: span 1;
    }
  }

  @media (max-width: 760px) {
    .wrap {
      width: calc(100% - 32px);
    }

    .hero {
      padding: 112px 0 48px;
    }

    .sec {
      padding: 52px 0;
    }

    .sec-head--row {
      flex-direction: column;
      align-items: flex-start;
    }

    .bento,
    .project-row,
    .library {
      grid-template-columns: 1fr;
    }

    .b-lg,
    .b-wide {
      grid-column: auto;
    }

    .author {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
</body>
</html>
