const aiIcoStyle = 'background:rgba(0,131,168,.1);color:#0083A8';
const mktIcoStyle = 'background:rgba(161,103,10,.1);color:#A1670A';
const booksIcoStyle = 'background:rgba(109,67,214,.1);color:#6D43D6';

const catIcoStyle: Record<string, string> = { ai: aiIcoStyle, mkt: mktIcoStyle, books: booksIcoStyle };
const catTagClass: Record<string, string> = { ai: 'tag-ai', mkt: 'tag-mkt', books: 'tag-books' };

// Logos not on Simple Icons are self-hosted brand favicons in /public/tool-logos.
const tools = [
  { cat: 'ai', name: 'ChatGPT', tag: 'AI Chat', icon: 'openai', desc: 'Conversational AI for drafting, research, and quick ideation.' },
  { cat: 'ai', name: 'Claude', tag: 'AI Assistant', icon: 'claude', desc: 'Reasoning-heavy assistant for writing, analysis, and strategy docs.' },
  { cat: 'ai', name: 'Perplexity', tag: 'AI Search', icon: 'perplexity', desc: 'Real-time answer engine with cited, verifiable sources.' },
  { cat: 'ai', name: 'Midjourney', tag: 'AI Image', logoImg: '/tool-logos/midjourney.png', desc: 'Generates high-fidelity images and visual concepts from text.' },
  { cat: 'ai', name: 'Notion AI', tag: 'AI Productivity', icon: 'notion', desc: 'AI-native workspace for notes, roadmaps, and specs.' },
  { cat: 'ai', name: 'GitHub Copilot', tag: 'AI Coding', icon: 'githubcopilot', desc: 'In-editor pair programmer that autocompletes and explains code.' },
  { cat: 'ai', name: 'Cursor', tag: 'AI Coding', icon: 'cursor', desc: 'AI-first code editor built for fast, context-aware iteration.' },
  { cat: 'ai', name: 'Gamma', tag: 'AI Docs', logoImg: '/tool-logos/gamma.jpg', desc: 'Turns rough outlines into polished decks and one-pagers.' },
  { cat: 'ai', name: 'ElevenLabs', tag: 'AI Voice', icon: 'elevenlabs', desc: 'Natural text-to-speech and voice cloning for content and demos.' },
  { cat: 'ai', name: 'Runway', tag: 'AI Video', logoImg: '/tool-logos/runway.png', desc: 'Generative video editing, effects, and motion tools.' },
  { cat: 'mkt', name: 'Google Analytics 4', tag: 'Analytics', icon: 'googleanalytics', desc: 'Cross-platform behavior tracking, funnels, and reporting.' },
  { cat: 'mkt', name: 'Google Tag Manager', tag: 'Tagging', icon: 'googletagmanager', desc: 'Deploy and manage tracking tags without touching code.' },
  { cat: 'mkt', name: 'SEMrush', tag: 'SEO', icon: 'semrush', desc: 'Keyword research, technical audits, and competitor tracking.' },
  { cat: 'mkt', name: 'Ahrefs', tag: 'SEO', logoImg: '/tool-logos/ahrefs.png', desc: 'Backlink analysis and organic search intelligence.' },
  { cat: 'mkt', name: 'HubSpot', tag: 'CRM', icon: 'hubspot', desc: 'CRM, email, and marketing automation in one platform.' },
  { cat: 'mkt', name: 'Mailchimp', tag: 'Email', icon: 'mailchimp', desc: 'Email campaigns, segmentation, and lifecycle automation.' },
  { cat: 'mkt', name: 'Canva', tag: 'Design', icon: 'canva', desc: 'Fast, drag-and-drop design for social and campaign assets.' },
  { cat: 'mkt', name: 'Buffer', tag: 'Social', icon: 'buffer', desc: 'Plan and publish content across social channels.' },
  { cat: 'mkt', name: 'Google Ads', tag: 'Paid Search', icon: 'googleads', desc: "Search and display advertising across Google's network." },
  { cat: 'mkt', name: 'Meta Ads Manager', tag: 'Paid Social', icon: 'meta', desc: 'Campaign management across Facebook and Instagram.' },
  { cat: 'books', name: 'Inspired', author: 'Marty Cagan', tag: 'Product', icon: 'book', desc: 'The definitive guide to building products customers love, from discovery to delivery.', href: 'https://link.amazon/B0ac6qZm9' },
  { cat: 'books', name: 'Continuous Discovery Habits', author: 'Teresa Torres', tag: 'Product', icon: 'book', desc: 'A practical framework for weekly customer touchpoints that keep decisions grounded in reality.', href: 'https://link.amazon/B064oiiSi' },
  { cat: 'books', name: 'Hooked', author: 'Nir Eyal', tag: 'Growth', icon: 'book', desc: 'The four-step Hook Model behind habit-forming products, from trigger to investment.', href: 'https://link.amazon/B07zVIUhj' },
  { cat: 'books', name: 'The Lean Startup', author: 'Eric Ries', tag: 'Growth', icon: 'book', desc: 'Build-measure-learn: validated learning and rapid iteration for uncertain, high-growth ventures.', href: 'https://link.amazon/B0hwZ7Cx9' },
  { cat: 'books', name: 'Positioning', author: 'Al Ries & Jack Trout', tag: 'Marketing', icon: 'book', desc: "The classic on owning a distinct place in the customer's mind amid competing noise.", href: 'https://link.amazon/B0hXOoyWt' },
  { cat: 'books', name: 'Crossing the Chasm', author: 'Geoffrey Moore', tag: 'Marketing', icon: 'book', desc: 'How to take a product from early adopters to the mainstream market without stalling.', href: 'https://link.amazon/B09VbEHWY' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI & Marketing Tools + Must-Read Books | Bedanta Gogoi</title>
    <meta
      name="description"
      content="A curated toolkit of AI and marketing tools — ChatGPT, Claude, SEMrush, HubSpot, and more — plus must-read product, growth, and marketing books."
    />
    <meta
      name="keywords"
      content="AI tools for product managers, marketing tools, best AI tools, product management tools, growth marketing tools, SEO tools, AI productivity tools, product management books, growth books, marketing books, bedanta gogoi"
    />
    <meta property="og:title" content="AI & Marketing Tools + Must-Read Books | Bedanta Gogoi" />
    <meta
      property="og:description"
      content="A curated toolkit of AI and marketing tools — ChatGPT, Claude, SEMrush, HubSpot, and more — plus must-read product, growth, and marketing books."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bedanta Gogoi — Product Manager" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/ai-tools/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="ai-tools" />

      <div class="filters" role="group" aria-label="Filter by category">
        <button class="filter-pill" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="filter-pill" type="button" data-filter="ai" aria-pressed="false">AI</button>
        <button class="filter-pill" type="button" data-filter="mkt" aria-pressed="false">Marketing</button>
        <button class="filter-pill" type="button" data-filter="books" aria-pressed="false">Books</button>
      </div>

      <section class="product-grid" aria-label="Tools and books">
        {
          tools.map((tool) => {
            const Tag = tool.href ? 'a' : 'div';
            return (
              <Tag
                class="product-card"
                data-cat={tool.cat}
                href={tool.href}
                target={tool.href ? '_blank' : undefined}
                rel={tool.href ? 'noopener noreferrer sponsored' : undefined}
              >
                <div class="product-head">
                  <div class="product-ico" style={catIcoStyle[tool.cat]}>
                    {tool.logoImg ? (
                      <img src={tool.logoImg} alt={`${tool.name} logo`} class="product-ico-img" />
                    ) : (
                      <svg viewBox="0 0 24 24" fill="currentColor" set:html={icons[tool.icon ?? '']} />
                    )}
                  </div>
                  <span class={`product-tag ${catTagClass[tool.cat]}`}>{tool.tag}</span>
                </div>
                <h3 class="product-title">{tool.name}</h3>
                {tool.author && <p class="product-author">by {tool.author}</p>}
                <p class="product-desc">{tool.desc}</p>
                <div class="product-visit">{tool.cat === 'books' ? 'Read' : 'Visit'} &rarr;</div>
              </Tag>
            );
          })
        }
      </section>
    </main>

    <SiteFooter />

    <script>
      const pills = Array.from(document.querySelectorAll('.filter-pill'));
      const cards = Array.from(document.querySelectorAll('.product-card'));

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => p.setAttribute('aria-pressed', 'false'));
          pill.setAttribute('aria-pressed', 'true');
          const filter = pill.getAttribute('data-filter');
          cards.forEach((card) => {
            const show = filter === 'all' || card.getAttribute('data-cat') === filter;
            card.hidden = !show;
          });
        });
      });
    </script>
  </body>
</html>
