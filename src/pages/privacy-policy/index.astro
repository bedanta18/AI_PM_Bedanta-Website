---
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '../../styles/blog.css';

const lastUpdated = new Date('2026-08-29');

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy Policy</title>
    <meta
      name="description"
      content="How this site handles your data — what's collected, what isn't, and how to reach out with privacy questions."
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content="Privacy Policy" />
    <meta
      property="og:description"
      content="How this site handles your data — what's collected, what isn't, and how to reach out with privacy questions."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bedanta Gogoi — Product Manager" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/privacy-policy/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell article-shell">
      <SiteNav current="privacy-policy" />

      <article class="article">
        <a class="back-link" href="/">Back to home</a>
        <header class="article-header">
          <div class="post-meta">
            <time datetime={lastUpdated.toISOString()}>Last updated {formatDate(lastUpdated)}</time>
          </div>
          <h1>Privacy Policy</h1>
          <p>
            This site is a personal portfolio belonging to Bedanta Gogoi. This policy explains what
            information is collected when you visit, how it's used, and who to contact with questions.
          </p>
        </header>

        <div class="article-body">
          <h2>Overview</h2>
          <p>
            This is a static portfolio and blog — it doesn't run a backend, doesn't ask you to create an
            account, and doesn't have any forms that collect personal information. The only way to reach
            out is via the email or social links on the site, and any information you share that way is
            shared voluntarily and directly with me.
          </p>

          <h2>Information Collected</h2>
          <p>
            This site uses Google Analytics (GA4) to understand overall traffic, such as which pages get
            visited and how people generally arrive here. Google Analytics collects information like your
            approximate location (derived from IP address, which Google truncates before storage), device
            and browser type, pages viewed, and how long you spend on the site. This data is aggregated
            and I don't use it to identify you personally.
          </p>
          <p>
            Beyond that, the only other data generated by a visit is what your browser and my hosting
            provider exchange to serve the page — things like your IP address, browser type, and the pages
            requested. This is standard server-log information common to virtually every website on the
            internet, is retained only by the hosting provider's infrastructure, and is not used by me to
            identify or profile individual visitors.
          </p>
          <p>
            If you email me directly (for example, via a <code>mailto:</code> link), I receive whatever
            information you choose to include in that email — such as your name, email address, and
            message content. That information is used only to respond to you and is not sold, rented, or
            shared with third parties.
          </p>

          <h2>Cookies &amp; Tracking</h2>
          <p>
            Google Analytics sets cookies (such as <code>_ga</code> and <code>_ga_*</code>) in your
            browser to distinguish visitors and measure site usage across visits. These cookies are set by
            Google, not by any code I write myself, and are governed by
            {' '}<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy</a>.
            No advertising or retargeting cookies are used on this site.
          </p>
          <p>
            You can opt out of Google Analytics tracking by installing the
            {' '}<a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>,
            or by using your browser's built-in cookie controls or a tracker-blocking extension. Doing so
            won't affect your ability to use the site.
          </p>

          <h2>Third-Party Services</h2>
          <p>The site relies on a small number of third-party services to function:</p>
          <ul>
            <li>
              <strong>Google Analytics</strong> — measures site traffic and usage, as described above,
              under <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy</a>.
            </li>
            <li>
              <strong>Google Fonts</strong> — typefaces are loaded from Google's servers, which may log
              standard request data (such as IP address) under
              <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's own privacy policy</a>.
            </li>
            <li>
              <strong>Hosting &amp; CDN</strong> — the site is served by a static hosting provider, which
              processes standard access logs to deliver pages.
            </li>
          </ul>
          <p>
            Links to external profiles like LinkedIn and Medium are provided for convenience. Visiting
            those sites is governed by their own privacy policies, not this one.
          </p>

          <h2>Data Retention &amp; Security</h2>
          <p>
            Since this site doesn't collect or store personal data beyond routine hosting logs, there's no
            personal database to retain or secure. Any email correspondence is kept only as long as
            reasonably useful for context on an ongoing conversation, and you can ask me to delete it at
            any time.
          </p>

          <h2>Children's Privacy</h2>
          <p>
            This site is not directed at children, and I don't knowingly collect personal information from
            anyone under the age of 13.
          </p>

          <h2>Your Rights</h2>
          <p>
            If you've emailed me and would like to know what information I hold about you, or would like
            it corrected or deleted, just ask — reach out at the email address below and I'll act on it
            promptly. This applies regardless of where you're located, including under frameworks like the
            GDPR or CCPA.
          </p>

          <h2>Changes to This Policy</h2>
          <p>
            This policy may be updated occasionally to reflect changes to the site or to legal
            requirements. The "Last updated" date at the top of this page will always reflect the most
            recent revision.
          </p>

          <h2>Contact</h2>
          <p>
            Questions about this policy or how your information is handled? Email
            {' '}<a href="mailto:bedanta.product@gmail.com">bedanta.product@gmail.com</a>.
          </p>
        </div>
      </article>
    </main>

    <SiteFooter />
  </body>
</html>
