    <li><a href="https://www.aipmbedanta.com/pm-concepts/">PM Concepts</a></li>
    <li><a href="https://www.aipmbedanta.com/ai-tools/">AI Tools</a></li>
    <li><a href="https://www.aipmbedanta.com/resources/" class="active">Resources</a></li>
    <li><a href="https://www.aipmbedanta.com/#contact" class="cta-pill">Hire Me</a></li>
  </ul>
</nav>

<!-- ── PAGE HERO ─────────────────────────────── -->
<section class="page-hero">
  <div class="orb orb1"></div>
  <div class="orb orb2"></div>
  <div class="hero-inner">
    <div class="sr">
      <div class="sec-label">Resources</div>
      <h1 class="page-title">Free Tools &amp; Templates<br>for <span class="grad-text">Product Managers</span></h1>
      <p class="page-sub">Real artifacts from real PM work — PRD templates, growth trackers, AI prompt packs, and checklists. Built from 6+ years across SaaS, Q-commerce, and PropTech.</p>
    </div>
    <div class="hero-stats sr">
      <div>
        <span class="stat-v">12</span>
        <div class="stat-l">Free Resources</div>
      </div>
      <div>
        <span class="stat-v">4</span>
        <div class="stat-l">Categories</div>
      </div>
      <div>
        <span class="stat-v">100%</span>
        <div class="stat-l">Free — No Paywall</div>
      </div>
      <div>
        <span class="stat-v">↑</span>
        <div class="stat-l">Updated Regularly</div>
      </div>
    </div>
  </div>
</section>

<!-- ── RESOURCES ─────────────────────────────── -->
<div class="main">

  <!-- Filter Bar -->
  <div class="filter-bar sr">
    <button class="filter-btn active" data-filter="all">All Resources</button>
    <button class="filter-btn" data-filter="pm">PM Templates</button>
    <button class="filter-btn" data-filter="growth">Growth</button>
    <button class="filter-btn" data-filter="ai">AI PM</button>
    <button class="filter-btn" data-filter="check">Checklists</button>
  </div>

  <!-- Resource Grid -->
  <div class="resource-grid">

    <!-- 1. PRD Template -->
    <div class="rcard" data-cat="pm">
      <div class="rcard-top">
        <span class="cat-badge cat-pm">PM Templates</span>
        <span class="format-badge">
          <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M14 2H6a2 2 0 00-2 2v9a2 2 0 002 2h9a2 2 0 002-2V4l-3-2z"/><polyline points="14 2 14 6 10 6"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="6" y1="12" x2="10" y2="12"/></svg>
          Google Docs
        </span>
      </div>
      <span class="rcard-icon">📄</span>
      <h3 class="rcard-title">PRD Template</h3>
      <p class="rcard-desc">A structured Product Requirements Document covering everything from problem framing to success metrics. Based on the PRDs used at Zopping and Oculon AI.</p>
      <div class="inside-label">What's inside</div>
