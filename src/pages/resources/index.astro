---
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '../../styles/blog.css';
import '../../styles/products.css';
import '../../styles/resources.css';

const catLabels: Record<string, string> = {
  pm: 'PM Templates',
  growth: 'Growth',
  ai: 'AI PM',
  check: 'Checklists',
};

const resources = [
  {
    cat: 'pm',
    format: '📄 Google Docs',
    icon: '📄',
    title: 'PRD Template',
    desc: 'A structured Product Requirements Document covering everything from problem framing to success metrics. Based on the PRDs used at Zopping and Oculon AI.',
    inside: [
      'Problem statement & user pain framing',
      'Goals, non-goals & success metrics',
      'User stories with acceptance criteria',
      'Technical constraints & dependencies',
      'Launch checklist & rollout plan',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'pm',
    format: '📊 Google Sheets',
    icon: '🗺️',
    title: 'Product Roadmap Template',
    desc: 'A quarterly roadmap tracker for teams managing multiple features and initiatives. Supports both now-next-later and calendar views.',
    inside: [
      'Quarterly initiative tracker',
      'Feature-level priority & status columns',
      'Dependencies & ownership mapping',
      'Progress dashboard with auto-calculations',
      'Stakeholder view (executive summary tab)',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'pm',
    format: '📊 Google Sheets',
    icon: '🔬',
    title: 'Competitive Analysis Canvas',
    desc: 'The exact framework used to benchmark 40+ FP&A tools during the Oculon AI product build. Adapt it for any market.',
    inside: [
      'Feature-by-feature comparison matrix',
      'Pricing & positioning tracker',
      'Target ICP mapping per competitor',
      'Strengths & weaknesses summary',
      'White space opportunity identifier',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'pm',
    format: '📝 Notion',
    icon: '🗂️',
    title: 'User Story Map Template',
    desc: 'A JTBD-informed story map that helps teams visualise the full user journey before writing a single line of code.',
    inside: [
      'User activity → task → story hierarchy',
      'Persona & JTBD context columns',
      'Release slicing view (MVP vs V2)',
      'Story point & sprint tagging',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'growth',
    format: '📄 Google Docs',
    icon: '🚀',
    title: 'GTM Strategy Template',
    desc: "A go-to-market playbook template built from real launch experience across Zopping merchants, Oculon beta, and Styldod's viral growth campaign.",
    inside: [
      'Target audience & ICP definition',
      'Positioning statement framework',
      'Channel strategy & budget allocation',
      'Launch timeline & milestone tracker',
      'Success metrics & KPI dashboard',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'growth',
    format: '📊 Google Sheets',
    icon: '🎯',
    title: 'OKR Tracker',
    desc: 'A quarterly OKR tracker with health indicators and auto-calculated progress scores. Built for small product teams and growth squads.',
    inside: [
      'Objective + Key Result structure',
      'Weekly check-in columns with RAG status',
      'Auto-score calculation (0–1 scale)',
      'Team & individual OKR separation',
      'Quarter-over-quarter comparison view',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'growth',
    format: '📊 Google Sheets',
    icon: '🧪',
    title: 'A/B Test Log',
    desc: 'Track every experiment your team runs — hypothesis, sample size, results, and learnings — in one structured log that builds institutional knowledge.',
    inside: [
      'Hypothesis & test design section',
      'Sample size calculator (built-in formula)',
      'Control vs variant result tracker',
      'Statistical significance flag',
      'Learnings & next steps log',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'ai',
    format: '📝 Notion',
    icon: '🤖',
    title: 'AI Prompt Pack for PMs',
    desc: '25+ battle-tested prompts for every stage of the PM workflow — from user research synthesis to PRD drafting, sprint planning, and stakeholder updates.',
    inside: [
      'User interview synthesis prompts',
      'PRD & user story generation prompts',
      'Competitive analysis prompts',
      'Stakeholder update drafting prompts',
      'Sprint retro & OKR writing prompts',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'ai',
    format: '🌐 Web Page',
    icon: '⚡',
    title: 'AI Tools Stack for PMs',
    desc: 'A curated, categorised directory of AI and marketing tools actually used in day-to-day PM and growth work — updated regularly.',
    inside: [
      'AI writing & research tools',
      'Analytics & data tools',
      'SEO & marketing tools',
      'Design & prototyping tools',
      'Coding & automation tools',
    ],
    href: '/ai-tools/',
    cta: 'View Directory',
    isInternalLink: true,
  },
  {
    cat: 'check',
    format: '📁 PDF',
    icon: '✅',
    title: 'Product Launch Checklist',
    desc: 'A 20-point pre- and post-launch checklist for shipping product features without anything slipping through the cracks.',
    inside: [
      'Pre-launch: engineering, QA, analytics',
      'Pre-launch: comms, enablement, support',
      'Launch day: monitoring & escalation',
      'Post-launch: data review & iteration',
    ],
    href: '#',
    cta: 'Download Free',
  },
  {
    cat: 'check',
    format: '📁 PDF',
    icon: '🎓',
    title: 'PM Interview Prep Checklist',
    desc: 'A structured guide for senior PM interviews — covering product design, estimation, strategy, and behavioural questions with frameworks for each.',
    inside: [
      'Product design question framework',
      'Estimation & metrics approach',
      'Strategy & root cause frameworks',
      'STAR method for behavioural Qs',
      'Questions to ask the interviewer',
    ],
    comingSoon: true,
  },
  {
    cat: 'check',
    format: '📊 Google Sheets',
    icon: '🧭',
    title: 'Onboarding Audit Checklist',
    desc: "The audit framework behind Zopping's onboarding revamp that led to 2.5× faster activation. Use it to score and fix your own onboarding flow.",
    inside: [
      'First-session friction audit (35 checks)',
      'Activation milestone identification',
      'Aha moment mapping worksheet',
      'Drop-off point identification guide',
      'Fix prioritisation matrix',
    ],
    comingSoon: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Free PM Resources & Templates | Bedanta Gogoi</title>
    <meta
      name="description"
      content="Free product management templates, growth frameworks, AI prompt packs, and checklists — built from real PM work by Bedanta Gogoi."
    />
    <meta
      name="keywords"
      content="product management templates, free PRD template, product roadmap template, PM checklist, GTM template, OKR tracker, AI prompts for product managers, growth templates, bedanta gogoi"
    />
    <meta property="og:title" content="Free PM Resources & Templates | Bedanta Gogoi" />
    <meta
      property="og:description"
      content="Free product management templates, growth frameworks, AI prompt packs, and checklists — built from real PM work."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/resources/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="resources" />

      <header class="blog-hero">
        <p class="eyebrow">Resources</p>
        <h1>Free Tools &amp; Templates for Product Managers</h1>
        <p>
          Real artifacts from real PM work — PRD templates, growth trackers, AI prompt packs, and checklists. Built from 6+ years across SaaS, Q-commerce, and PropTech.
        </p>
        <div class="resources-stats">
          <div>
            <span class="stat-v">{resources.length}</span>
            <div class="stat-l">Free Resources</div>
          </div>
          <div>
            <span class="stat-v">{Object.keys(catLabels).length}</span>
            <div class="stat-l">Categories</div>
          </div>
          <div>
            <span class="stat-v">100%</span>
            <div class="stat-l">Free — No Paywall</div>
          </div>
          <div>
            <span class="stat-v">↑</span>
            <div class="stat-l">Updated Regularly</div>
          </div>
        </div>
      </header>

      <div class="filters" role="group" aria-label="Filter by category">
        <button class="filter-pill" type="button" data-filter="all" aria-pressed="true">All Resources</button>
        {
          Object.entries(catLabels).map(([key, label]) => (
            <button class="filter-pill" type="button" data-filter={key} aria-pressed="false">
              {label}
            </button>
          ))
        }
      </div>

      <section class="resource-grid" aria-label="Free resources">
        {
          resources.map((item) => (
            <div class="resource-card" data-cat={item.cat}>
              <div class="resource-top">
                <span class={`resource-cat-badge cat-${item.cat}`}>{catLabels[item.cat]}</span>
                {item.format && <span class="resource-format">{item.format}</span>}
              </div>
              <span class="resource-icon">{item.icon}</span>
              <h3 class="resource-title">{item.title}</h3>
              <p class="resource-desc">{item.desc}</p>
              <div class="resource-inside-label">What's inside</div>
              <ul class="resource-inside">
                {item.inside.map((point) => <li>{point}</li>)}
              </ul>
              <div class="resource-footer">
                {item.comingSoon ? (
                  <span class="resource-dl-btn is-soon">Coming Soon</span>
                ) : (
                  <a href={item.href} class="resource-dl-btn">
                    {item.cta}
                    {item.isInternalLink ? (
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 8h10M9 4l4 4-4 4" />
                      </svg>
                    ) : (
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="white" stroke-width="2" stroke-linecap="round">
                        <path d="M8 2v9M4 7l4 5 4-5" />
                        <line x1="2" y1="14" x2="14" y2="14" />
                      </svg>
                    )}
                  </a>
                )}
                <span class="resource-free-tag">Free</span>
              </div>
            </div>
          ))
        }
      </section>

      <div class="cs-banner">
        <div class="cs-text">
          <h3>More resources dropping soon</h3>
          <p>Sprint Retrospective Template, Campaign Brief Template, and a PM Career Roadmap guide are in progress. Drop your email and I'll notify you when they're live.</p>
        </div>
        <form class="cs-form">
          <input class="cs-input" type="email" placeholder="your@email.com" required />
          <button class="cs-btn" type="submit">Notify Me</button>
        </form>
      </div>
    </main>

    <SiteFooter />

    <script>
      const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-pill'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.resource-card'));

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => p.setAttribute('aria-pressed', 'false'));
          pill.setAttribute('aria-pressed', 'true');
          const filter = pill.getAttribute('data-filter');
          cards.forEach((card) => {
            const show = filter === 'all' || card.getAttribute('data-cat') === filter;
            card.hidden = !show;
          });
        });
      });
    </script>
  </body>
</html>
