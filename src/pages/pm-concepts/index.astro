---
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '../../styles/blog.css';

const posts = (await getCollection('pmConcepts'))
  .filter((post) => post.data.ispublished)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [...new Set(posts.flatMap((post) => post.data.categories))].sort();

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Management Concepts & Frameworks | Bedanta Gogoi</title>
    <meta
      name="description"
      content="A growing glossary of PM concepts and frameworks — RICE, North Star Metric, Jobs to Be Done, and more — explained by Bedanta Gogoi."
    />
    <meta
      name="keywords"
      content="product management concepts, product management frameworks, RICE prioritization, North Star Metric, Jobs to Be Done, PM glossary, product manager frameworks, bedanta gogoi"
    />
    <meta property="og:title" content="Product Management Concepts & Frameworks | Bedanta Gogoi" />
    <meta
      property="og:description"
      content="A growing glossary of product management concepts and frameworks — RICE prioritization, North Star Metric, Jobs to Be Done, and more — explained by Product Manager Bedanta Gogoi."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/pm-concepts/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="pm-concepts" />

      <header class="blog-hero">
        <p class="eyebrow">Glossary</p>
        <h1>PM Concepts</h1>
        <p>
          A growing glossary of product management concepts and frameworks — the mental models behind the day-to-day decisions.
        </p>
      </header>

      <section class="category-band" aria-labelledby="categories-title">
        <h2 id="categories-title">Categories</h2>
        <div class="category-list">
          {categories.map((category) => <a href={`#${category.toLowerCase().replaceAll(' ', '-')}`}>{category}</a>)}
        </div>
      </section>

      <section class="post-grid" aria-label="Published PM concepts">
        {
          posts.map((post) => (
            <article class="post-card" id={post.data.categories[0]?.toLowerCase().replaceAll(' ', '-')}>
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span>{post.data.author}</span>
              </div>
              <h2>
                <a href={`/pm-concepts/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{post.data.desc}</p>
              <div class="chip-row">
                {post.data.categories.map((category) => <span>{category}</span>)}
              </div>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>
