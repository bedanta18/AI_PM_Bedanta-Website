---
import { getCollection, render } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (post) => post.data.ispublished);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const seoTitle = post.data.metaTitle ?? post.data.title;
const seoDescription = post.data.metaDescription ?? post.data.desc;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoTitle} | Bedanta Gogoi</title>
    <meta name="description" content={seoDescription} />
    {post.data.keywords.length > 0 && (
      <meta name="keywords" content={post.data.keywords.join(', ')} />
    )}
    <meta name="author" content={post.data.author} />
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:author" content={post.data.author} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content="article" />
    <link rel="canonical" href={`https://www.aipmbedanta.com/blog/${post.id}/`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell article-shell">
      <SiteNav current="blog" />

      <article class="article">
        <a class="back-link" href="/blog/">Back to blog</a>
        <header class="article-header">
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span>{post.data.author}</span>
          </div>
          <h1>{post.data.title}</h1>
          <p>{post.data.desc}</p>
          <div class="chip-row">
            {post.data.categories.map((category) => <span>{category}</span>)}
          </div>
        </header>
        <div class="article-body">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>
