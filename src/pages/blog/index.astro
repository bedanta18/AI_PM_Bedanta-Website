---
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/blog.css';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.ispublished)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [...new Set(posts.flatMap((post) => post.data.categories))].sort();

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Management & Growth Blog | Bedanta Gogoi</title>
    <meta
      name="description"
      content="Essays and field notes on product management, SaaS, quick commerce, analytics, and growth — written by Product Manager Bedanta Gogoi."
    />
    <meta
      name="keywords"
      content="product management blog, growth blog, SaaS product management, quick commerce, product manager notes, GTM strategy, product analytics, bedanta gogoi"
    />
    <meta property="og:title" content="Product Management & Growth Blog | Bedanta Gogoi" />
    <meta
      property="og:description"
      content="Essays and field notes on product management, SaaS, quick commerce, analytics, and growth — written by Product Manager Bedanta Gogoi."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://www.aipmbedanta.com/blog/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="blog" />

      <section class="category-band" aria-labelledby="categories-title">
        <h2 id="categories-title">Categories</h2>
        <div class="category-list">
          {categories.map((category) => <a href={`#${category.toLowerCase().replaceAll(' ', '-')}`}>{category}</a>)}
        </div>
      </section>

      <section class="post-grid" aria-label="Published blog posts">
        {
          posts.map((post) => (
            <article class="post-card" id={post.data.categories[0]?.toLowerCase().replaceAll(' ', '-')}>
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span>{post.data.author}</span>
              </div>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{post.data.desc}</p>
              <div class="chip-row">
                {post.data.categories.map((category) => <span>{category}</span>)}
              </div>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  .blog-shell {
    padding-top: 90px;
  }

  .blog-shell .category-band {
    border-top: none;
    padding-top: 0;
  }

  @media (max-width: 760px) {
    .blog-shell {
      padding-top: 76px;
    }
  }
</style>
