---
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '../../styles/blog.css';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.ispublished)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Fixed to the site's four content pillars so the filter always shows exactly
// these four, in this order, regardless of which posts currently exist or
// which incidental tags (e.g. "SEO") show up in post frontmatter.
const categories = ['Product Management', 'Marketing', 'Growth', 'AI'];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Management & Growth Blog | Bedanta Gogoi</title>
    <meta
      name="description"
      content="Essays and field notes on product management, SaaS, quick commerce, analytics, and growth — written by Product Manager Bedanta Gogoi."
    />
    <meta
      name="keywords"
      content="product management blog, growth blog, SaaS product management, quick commerce, product manager notes, GTM strategy, product analytics, bedanta gogoi"
    />
    <meta property="og:title" content="Product Management & Growth Blog | Bedanta Gogoi" />
    <meta
      property="og:description"
      content="Essays and field notes on product management, SaaS, quick commerce, analytics, and growth — written by Product Manager Bedanta Gogoi."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bedanta Gogoi — Product Manager" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/blog/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="blog" />

      <section class="category-band" aria-labelledby="categories-title">
        <h2 id="categories-title">Categories</h2>
        <div class="category-list" role="group" aria-label="Filter posts by category">
          <button type="button" class="category-chip is-active" data-category="all" aria-pressed="true">All</button>
          {
            categories.map((category) => (
              <button type="button" class="category-chip" data-category={category} aria-pressed="false">
                {category}
              </button>
            ))
          }
        </div>
      </section>

      <section class="post-grid" aria-label="Published blog posts">
        {
          posts.map((post) => (
            <article class="post-card" data-categories={post.data.categories.join('||')}>
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span>{post.data.author}</span>
              </div>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{post.data.desc}</p>
              <div class="chip-row">
                {post.data.categories.map((category) => <span>{category}</span>)}
              </div>
            </article>
          ))
        }
      </section>
      <p class="no-results" hidden>No posts in this category yet.</p>
    </main>

    <SiteFooter />

    <script>
      const chips = document.querySelectorAll<HTMLButtonElement>('.category-chip');
      const cards = document.querySelectorAll<HTMLElement>('.post-card');
      const noResults = document.querySelector<HTMLElement>('.no-results');

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const selected = chip.dataset.category ?? 'all';

          chips.forEach((c) => {
            const isActive = c === chip;
            c.classList.toggle('is-active', isActive);
            c.setAttribute('aria-pressed', String(isActive));
          });

          let visibleCount = 0;
          cards.forEach((card) => {
            const cardCategories = card.dataset.categories ? card.dataset.categories.split('||') : [];
            const show = selected === 'all' || cardCategories.includes(selected);
            card.classList.toggle('is-hidden', !show);
            if (show) visibleCount += 1;
          });

          noResults?.toggleAttribute('hidden', visibleCount > 0);
        });
      });
    </script>
  </body>
</html>

<style>
  .blog-shell {
    padding-top: 90px;
  }

  .blog-shell .category-band {
    border-top: none;
    padding-top: 0;
  }

  .category-chip {
    font: inherit;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .category-chip:hover {
    background: rgba(52, 87, 209, 0.14);
  }

  .category-chip.is-active {
    background: var(--grad);
    border-color: transparent;
    color: #fff;
  }

  .category-chip.is-active:hover {
    background: var(--grad);
  }

  .post-card.is-hidden {
    display: none;
  }

  .no-results {
    padding: 32px 0 8px;
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 760px) {
    .blog-shell {
      padding-top: 76px;
    }
  }
</style>
