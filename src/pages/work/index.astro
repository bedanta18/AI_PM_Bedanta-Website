---
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/blog.css';
import '../../styles/work.css';

const items = (await getCollection('work'))
  .filter((item) => item.data.ispublished)
  .sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work | Bedanta Gogoi</title>
    <meta
      name="description"
      content="Case studies from Bedanta Gogoi's product management work across SaaS, quick commerce, PropTech, AI, and marketing analytics."
    />
    <link rel="canonical" href="https://www.aipmbedanta.com/work/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="work" />

      <header class="blog-hero">
        <p class="eyebrow">Case Studies</p>
        <h1>Products I've built & problems I've solved.</h1>
        <p>
          From zero-to-one launches to viral growth — every project shaped by obsessive user empathy and data-backed decisions.
        </p>
      </header>

      <section class="post-grid" aria-label="Case studies">
        {
          items.map((item) => (
            <article class:list={['post-card', { 'work-current': item.data.current }]}>
              <div class="post-meta">
                {item.data.logo && <img class="work-logo" src={item.data.logo} alt={`${item.data.company} logo`} />}
                <span class:list={['work-tag', item.data.tagVariant]}>{item.data.tag}</span>
              </div>
              <div class="work-co">
                {item.data.company} &middot; {item.data.dateRange}
              </div>
              {item.data.role && <div class="work-role">{item.data.role}</div>}
              <h2>
                <a href={`/work/${item.id}/`}>{item.data.title}</a>
              </h2>
              <p>{item.data.desc}</p>
              <div class="work-metrics">
                {item.data.metrics.map((metric) => (
                  <div>
                    <span class="work-met-v">{metric.value}</span>
                    <span class="work-met-l">{metric.label}</span>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>
