---
import { getCollection, render } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '../../styles/blog.css';
import '../../styles/work.css';

export async function getStaticPaths() {
  const items = await getCollection('work', (item) => item.data.ispublished);

  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{item.data.title} | Bedanta Gogoi</title>
    <meta name="description" content={item.data.desc} />
    <meta property="og:title" content={item.data.title} />
    <meta property="og:description" content={item.data.desc} />
    <meta property="og:type" content="article" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={`https://www.aipmbedanta.com/work/${item.id}/`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell article-shell">
      <SiteNav current="about" />

      <article class="article">
        <a class="back-link" href="/about/#work">Back to About Me</a>
        <header class="article-header">
          <div class="work-header-meta">
            {item.data.logo && <img class="work-logo" src={item.data.logo} alt={`${item.data.company} logo`} />}
            <span class:list={['work-tag', item.data.tagVariant]}>{item.data.tag}</span>
          </div>
          <div class="work-co">
            {item.data.company} &middot; {item.data.dateRange}
          </div>
          {item.data.role && <div class="work-role">{item.data.role}</div>}
          <h1>{item.data.title}</h1>
          <p>{item.data.desc}</p>
          <div class="work-metrics">
            {item.data.metrics.map((metric) => (
              <div>
                <span class="work-met-v">{metric.value}</span>
                <span class="work-met-l">{metric.label}</span>
              </div>
            ))}
          </div>
        </header>
        <div class="article-body">
          <Content />
        </div>
      </article>
    </main>
  </body>
</html>
