---
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import '../../styles/blog.css';

const CATEGORY = 'Product Management';

const SUBCATEGORIES = [
  'Product Strategy',
  'Product Discovery',
  'Product Design',
  'Product Analytics',
  'Product Metrics',
  'Product Growth',
  'Product Operations',
  'Product Frameworks',
  'Product Case Studies',
  'Product Interviews',
];

const posts = (await getCollection('blog'))
  .filter((post) => post.data.ispublished && post.data.categories.includes(CATEGORY))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const subcatOf = (post: (typeof posts)[number]) => post.data.subcategory[CATEGORY] ?? 'Other';

const groups = SUBCATEGORIES.map((name) => ({
  name,
  posts: posts.filter((post) => subcatOf(post) === name),
})).filter((group) => group.posts.length > 0);

// Catch-all for any post whose subcategory isn't in the list above.
const known = new Set(SUBCATEGORIES);
const otherPosts = posts.filter((post) => !known.has(subcatOf(post)));
if (otherPosts.length > 0) {
  groups.push({ name: 'Other', posts: otherPosts });
}

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Free Product Management Resources, Articles, Concepts & Frameworks</title>
    <meta
      name="description"
      content="Frameworks, case studies, and field notes on building products people love. Free product management articles on roadmapping, prioritization & GTM."
    />
    <meta
      name="keywords"
      content="product management, product manager, PM frameworks, product management case studies, product roadmap, product strategy, product led growth, AI product management, zero to one product, product manager guide, bedanta gogoi, aipmbedanta"
    />
    <meta property="og:title" content="Product Management Articles & Frameworks | aipmbedanta." />
    <meta
      property="og:description"
      content="Frameworks, case studies, and field notes on building products people love. Free product management articles on roadmapping, prioritization & GTM."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="aipmbedanta. — Product Management, Marketing, Growth & AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/product-management/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="product-management" />

      <a class="back-link" href="/blog/">← All Articles</a>
      <header class="blog-hero">
        <p class="eyebrow">Category</p>
        <h1>Product Management</h1>
        <p>Frameworks, case studies, and field notes on building products people love.</p>
      </header>

      <section class="category-band" aria-labelledby="subcat-title">
        <h2 id="subcat-title">Browse by Topic</h2>
        <div class="category-list" role="group" aria-label="Filter by subtopic">
          <button type="button" class="category-chip is-active" data-subcat="all" aria-pressed="true">All ({posts.length})</button>
          {
            groups.map((group) => (
              <button type="button" class="category-chip" data-subcat={group.name} aria-pressed="false">
                {group.name} ({group.posts.length})
              </button>
            ))
          }
        </div>
      </section>

      {
        groups.map((group) => (
          <section class="subcat-section" data-subcat-section={group.name} aria-label={group.name}>
            <h2 class="subcat-heading">{group.name}</h2>
            <p class="subcat-count">
              {group.posts.length} {group.posts.length === 1 ? 'article' : 'articles'}
            </p>
            <div class="post-grid">
              {group.posts.map((post) => (
                <article class="post-card">
                  <div class="post-meta">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <span>{post.data.author}</span>
                  </div>
                  <h3>
                    <a href={`/product-management/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p>{post.data.desc}</p>
                  <a class="read-link" href={`/product-management/${post.id}/`}>
                    Read <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))
      }
      {posts.length === 0 && <p class="no-results">No posts in this category yet.</p>}

      <section class="explore-more" aria-label="More Product Management resources">
        <h2>Explore More</h2>
        <div class="explore-grid">
          <a class="explore-card" href="/pm-concepts/">
            <h3>PM Concepts</h3>
            <p>A growing glossary of core product management frameworks — RICE, North Star Metric, Jobs to Be Done, and more.</p>
          </a>
          <a class="explore-card" href="/resources/">
            <h3>Free Resources</h3>
            <p>Free templates for PMs — PRDs, roadmaps, competitive analysis canvases, and more.</p>
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />

    <script>
      const chips = document.querySelectorAll<HTMLButtonElement>('.category-chip[data-subcat]');
      const sections = document.querySelectorAll<HTMLElement>('.subcat-section');

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const selected = chip.dataset.subcat ?? 'all';

          chips.forEach((c) => {
            const isActive = c === chip;
            c.classList.toggle('is-active', isActive);
            c.setAttribute('aria-pressed', String(isActive));
          });

          sections.forEach((section) => {
            const show = selected === 'all' || section.dataset.subcatSection === selected;
            section.classList.toggle('is-hidden', !show);
          });
        });
      });
    </script>
  </body>
</html>
