---
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import '../../styles/blog.css';

const CATEGORY = 'Growth';

const SUBCATEGORIES = [
  'Growth Strategy',
  'Growth Marketing',
  'PLG',
  'Retention',
  'Activation',
  'Experimentation',
  'SEO',
  'Growth Metrics',
];

const posts = (await getCollection('blog'))
  .filter((post) => post.data.ispublished && post.data.categories.includes(CATEGORY))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const subcatOf = (post: (typeof posts)[number]) => post.data.subcategory[CATEGORY] ?? 'Other';

const groups = SUBCATEGORIES.map((name) => ({
  name,
  posts: posts.filter((post) => subcatOf(post) === name),
})).filter((group) => group.posts.length > 0);

const known = new Set(SUBCATEGORIES);
const groupOf = (post: (typeof posts)[number]) => (known.has(subcatOf(post)) ? subcatOf(post) : 'Other');
const otherPosts = posts.filter((post) => !known.has(subcatOf(post)));
if (otherPosts.length > 0) {
  groups.push({ name: 'Other', posts: otherPosts });
}

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <ThemeInit />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Free resources for Growth Strategy, Articles and Frameworks</title>
    <meta
      name="description"
      content="Activation, retention, PLG, and the metrics that move the needle. Free growth strategy articles on activation, retention, SEO & product led growth."
    />
    <meta
      name="keywords"
      content="growth, growth strategy, activation, retention, product led growth, growth metrics, SEO strategy, growth marketing, PLG, bedanta gogoi, aipmbedanta"
    />
    <meta property="og:title" content="Growth Strategy Articles & Frameworks | aipmbedanta." />
    <meta
      property="og:description"
      content="Activation, retention, PLG, and the metrics that move the needle. Free growth strategy articles on activation, retention, SEO & product led growth."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="aipmbedanta. — Product Management, Marketing, Growth & AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/growth/" />
  </head>
  <body>
    <main class="blog-shell">
      <SiteNav current="growth" />

      <a class="back-link" href="/blog/">← All Articles</a>
      <header class="blog-hero">
        <p class="eyebrow">Category</p>
        <h1>Growth</h1>
        <p>Activation, retention, PLG, and the metrics that move the needle.</p>
      </header>

      <section class="category-band" aria-labelledby="subcat-title">
        <h2 id="subcat-title">Browse by Topic</h2>
        <div class="category-list" role="group" aria-label="Filter by subtopic">
          <button type="button" class="category-chip is-active" data-subcat="all" aria-pressed="true">All <span class="chip-count">{posts.length}</span></button>
          {
            groups.map((group) => (
              <button type="button" class="category-chip" data-subcat={group.name} aria-pressed="false">
                {group.name} <span class="chip-count">{group.posts.length}</span>
              </button>
            ))
          }
        </div>
      </section>

      <div class="post-grid hub-grid">
        {
          posts.map((post) => (
            <article class="post-card" data-subcat={groupOf(post)}>
              <div class="post-meta">
                <span class="post-tag">{subcatOf(post)}</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              <h3>
                <a href={`/growth/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.desc}</p>
              <span class="read-link">
                Read <span aria-hidden="true">→</span>
              </span>
            </article>
          ))
        }
      </div>
      {posts.length === 0 && <p class="no-results">No posts in this category yet.</p>}

      <section class="explore-more" aria-label="More Growth resources">
        <h2>Explore More</h2>
        <div class="explore-grid">
          <a class="explore-card" href="/my-recommendations/">
            <h3>AI &amp; Marketing Tools</h3>
            <p>A curated toolkit of AI and analytics tools used to run growth experiments and ship campaigns.</p>
          </a>
          <a class="explore-card" href="/resources/">
            <h3>Free Resources</h3>
            <p>Free templates for growth teams — GTM strategy, A/B test logs, OKR trackers, and more.</p>
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />

    <script>
      const chips = document.querySelectorAll<HTMLButtonElement>('.category-chip[data-subcat]');
      const cards = document.querySelectorAll<HTMLElement>('.hub-grid .post-card');

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const selected = chip.dataset.subcat ?? 'all';

          chips.forEach((c) => {
            const isActive = c === chip;
            c.classList.toggle('is-active', isActive);
            c.setAttribute('aria-pressed', String(isActive));
          });

          cards.forEach((card) => {
            const show = selected === 'all' || card.dataset.subcat === selected;
            card.classList.toggle('is-hidden', !show);
          });
        });
      });
    </script>
  </body>
</html>
