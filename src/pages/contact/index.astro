---
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GoogleTag from '../../components/GoogleTag.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import '../../styles/blog.css';
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <ThemeInit />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Get in Touch</title>
    <meta
      name="description"
      content="Reach out to Bedanta Gogoi — writer behind aipmbedanta.com covering PM, Marketing, Growth & AI."
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content="Get in Touch" />
    <meta
      property="og:description"
      content="Reach out to Bedanta Gogoi — writer behind aipmbedanta.com covering PM, Marketing, Growth & AI."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.aipmbedanta.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bedanta Gogoi — Product Manager" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.aipmbedanta.com/og-image.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://www.aipmbedanta.com/contact/" />
  </head>
  <body>
    <main class="blog-shell article-shell">
      <SiteNav current="contact" />

      <article class="article">
        <a class="back-link" href="/">Back to home</a>
        <header class="article-header">
          <p class="eyebrow">Contact</p>
          <h1>Get in Touch</h1>
          <p>
            Have a question about an article or template, spotted something to fix, or just want to
            connect? Reach out below.
          </p>
        </header>

        <div class="contact-grid">
          <div class="contact-card contact-card--email">
            <p class="contact-label">Email · best way to reach me</p>
            <a href="mailto:bedanta.product@gmail.com" class="contact-email">bedanta.product@gmail.com</a>
            <div class="contact-actions">
              <a class="btn btn-primary" href="mailto:bedanta.product@gmail.com">
                Write an email <span aria-hidden="true">→</span>
              </a>
              <button type="button" class="btn btn-ghost copy-email" data-email="bedanta.product@gmail.com">
                Copy address
              </button>
            </div>
          </div>

          <a class="contact-card contact-card--link" href="https://www.linkedin.com/in/bedantagogoi/" target="_blank" rel="noopener noreferrer">
            <span class="contact-ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </span>
            <span class="contact-label">LinkedIn</span>
            <span class="contact-handle">in/bedantagogoi</span>
            <span class="read-link">Connect <span aria-hidden="true">↗</span></span>
          </a>

          <a class="contact-card contact-card--link" href="https://medium.com/@bedanta.gogoi" target="_blank" rel="noopener noreferrer">
            <span class="contact-ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
            </span>
            <span class="contact-label">Medium</span>
            <span class="contact-handle">@bedanta.gogoi</span>
            <span class="read-link">Read <span aria-hidden="true">↗</span></span>
          </a>
        </div>
      </article>
    </main>

    <SiteFooter />
  </body>
</html>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.email ?? '');
        btn.textContent = 'Copied ✓';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (btn.textContent = label), 1800);
    });
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 40px;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    color: var(--text);
    text-decoration: none;
  }

  .contact-card--email {
    grid-column: 1 / -1;
    padding: 32px;
    border-color: var(--border-strong);
    background:
      radial-gradient(560px 260px at 0% 0%, var(--halo-1), transparent 70%),
      radial-gradient(420px 220px at 100% 100%, var(--halo-2), transparent 70%),
      var(--bg-elev);
  }

  .contact-card--link {
    transition: border-color 0.25s ease, transform 0.35s var(--ease);
  }

  .contact-card--link:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .contact-label {
    margin: 0;
    color: var(--quiet);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-email {
    margin-top: 6px;
    overflow-wrap: anywhere;
    color: var(--text);
    font-size: clamp(1.4rem, 3.4vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .contact-email:hover {
    color: var(--accent-text);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .contact-ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 14px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-strong);
    color: var(--text);
  }

  .contact-handle {
    margin-bottom: 14px;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .contact-card--link .read-link {
    margin-top: auto;
  }

  @media (max-width: 600px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-card--email {
      padding: 24px;
    }
  }
</style>
