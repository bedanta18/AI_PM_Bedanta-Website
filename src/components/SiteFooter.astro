<style>
  .site-footer {
    padding: 56px 6% 28px;
    background: #f7f9fe;
    border-top: 1px solid rgba(18, 26, 46, 0.08);
    color: rgba(18, 21, 28, 0.6);
    font-family: Arial, Helvetica, sans-serif;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: 48px;
    max-width: 1220px;
    margin: 0 auto;
    padding-bottom: 40px;
  }

  .footer-logo {
    display: inline-block;
    font-family: "Syne", sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
    margin-bottom: 14px;
    background: linear-gradient(130deg, #2647c2 0%, #2f83d6 45%, #00a3c4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-tagline {
    max-width: 320px;
    margin: 0 0 20px;
    font-size: 0.86rem;
    line-height: 1.65;
    font-weight: 400;
  }

  .footer-socials {
    display: flex;
    gap: 10px;
  }

  .footer-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(18, 26, 46, 0.1);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .footer-socials a:hover {
    border-color: rgba(52, 87, 209, 0.35);
    transform: translateY(-2px);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .footer-heading {
    margin: 0 0 16px;
    color: #12151c;
    font-family: "Syne", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-col a,
  .footer-tel {
    color: rgba(18, 21, 28, 0.62);
    font-size: 0.86rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #12151c;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: #0083a8 !important;
    font-weight: 700;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    max-width: 1220px;
    margin: 0 auto;
    padding-top: 24px;
    border-top: 1px solid rgba(18, 26, 46, 0.08);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-legal {
    display: flex;
    gap: 18px;
  }

  .footer-legal a {
    color: rgba(18, 21, 28, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: #12151c;
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
