<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding: 72px 0 0;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--muted);
    font-family: var(--font-body);
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: 56px;
    padding-bottom: 48px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .footer-logo > span > span {
    color: var(--muted);
    font-weight: 400;
  }

  .logo-mark {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--accent);
  }

  .logo-mark::after {
    content: '';
    position: absolute;
    inset: 5px 5px auto auto;
    width: 5px;
    height: 5px;
    border-radius: 1.5px;
    background: var(--accent-ink);
  }

  .footer-tagline {
    max-width: 320px;
    margin: 0 0 22px;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-socials {
    display: flex;
    gap: 8px;
  }

  .footer-socials a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .footer-socials a:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .footer-heading {
    margin: 0 0 16px;
    color: var(--quiet);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 11px;
    min-width: 0;
  }

  .footer-col a,
  .footer-tel {
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    color: var(--quiet);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-legal {
    display: flex;
    gap: 18px;
  }

  .footer-legal a {
    color: var(--quiet);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: var(--text);
  }

  /* Oversized outlined wordmark bleeding off the bottom edge. */
  .footer-wordmark {
    margin: 8px 0 -0.22em;
    color: transparent;
    font-family: var(--font-body);
    font-size: clamp(4rem, 17vw, 15rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    background: linear-gradient(to bottom, var(--border-strong), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
  }

  @media (max-width: 760px) {
    .footer-inner {
      width: calc(100% - 32px);
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
