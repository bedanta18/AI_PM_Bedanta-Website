---
interface Props {
  current?:
    | 'home'
    | 'blog'
    | 'about'
    | 'pm-concepts'
    | 'ai-concepts'
    | 'ai-tools'
    | 'resources'
    | 'contact'
    | 'privacy-policy'
    | 'terms';
}

const { current = 'home' } = Astro.props;
const homeHref = current === 'home' ? '#hero' : '/';
---

<nav aria-label="Primary navigation">
  <a class="nav-logo" href="/">BG.</a>
  <ul class="nav-links">
    <li><a href={homeHref}>Home</a></li>
    <li><a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About Me</a></li>
    <li><a href="/ai-tools/" aria-current={current === 'ai-tools' ? 'page' : undefined}>AI & Marketing Tools</a></li>
    <li><a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a></li>
    <li><a href="/pm-concepts/" aria-current={current === 'pm-concepts' ? 'page' : undefined}>PM Concepts</a></li>
    <li><a href="/ai-concepts/" aria-current={current === 'ai-concepts' ? 'page' : undefined}>AI Concepts</a></li>
    <li><a href="/resources/" aria-current={current === 'resources' ? 'page' : undefined}>Resources</a></li>
    <li><a href="https://www.aipmbedanta.com/contact/" class="cta-pill">Hire Me</a></li>
  </ul>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 6%;
    background: rgba(250, 251, 255, 0.8);
    border-bottom: 1px solid rgba(18, 26, 46, 0.08);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transition: background 0.3s;
  }

  .nav-logo {
    font-family: "Syne", sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0;
    text-decoration: none;
    background: linear-gradient(130deg, #2647c2 0%, #2f83d6 45%, #00a3c4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    color: rgba(18, 21, 28, 0.6);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    color: #12151c;
  }

  .nav-links .cta-pill {
    padding: 7px 20px;
    border-radius: 100px;
    background: linear-gradient(130deg, #3457d1 0%, #0083a8 100%);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    transition: opacity 0.2s, transform 0.2s;
  }

  .nav-links .cta-pill:hover {
    opacity: 0.85;
    transform: scale(1.04);
  }

  @media (max-width: 900px) {
    nav .nav-links li:not(:last-child) {
      display: none;
    }
  }
</style>
