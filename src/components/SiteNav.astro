---
interface Props {
  current?:
    | 'home'
    | 'product-management'
    | 'marketing'
    | 'growth'
    | 'ai'
    | 'resources'
    | 'about'
    | 'blog'
    | 'pm-concepts'
    | 'ai-concepts'
    | 'ai-tools'
    | 'contact'
    | 'privacy-policy'
    | 'terms';
}

const { current = 'home' } = Astro.props;
const resourcesActive = current === 'resources' || current === 'ai-concepts' || current === 'pm-concepts';
---

<nav aria-label="Primary navigation">
  <a class="nav-logo" href="/">aipmbedanta</a>
  <ul class="nav-links">
    <li><a href="/product-management/" aria-current={current === 'product-management' ? 'page' : undefined}>Product Management</a></li>
    <li><a href="/marketing/" aria-current={current === 'marketing' ? 'page' : undefined}>Marketing</a></li>
    <li><a href="/growth/" aria-current={current === 'growth' ? 'page' : undefined}>Growth</a></li>
    <li><a href="/ai/" aria-current={current === 'ai' ? 'page' : undefined}>AI</a></li>
    <li class="nav-dropdown">
      <button
        type="button"
        class="nav-dropdown-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-current={resourcesActive ? 'page' : undefined}
      >
        Resources
        <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
          <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <ul class="dropdown-menu">
        <li><a href="/resources/" aria-current={current === 'resources' ? 'page' : undefined}>Resources</a></li>
        <li><a href="/ai-concepts/" aria-current={current === 'ai-concepts' ? 'page' : undefined}>AI Concepts</a></li>
        <li><a href="/pm-concepts/" aria-current={current === 'pm-concepts' ? 'page' : undefined}>PM Concepts</a></li>
      </ul>
    </li>
    <li><a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About Me</a></li>
  </ul>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 6%;
    background: rgba(250, 251, 255, 0.8);
    border-bottom: 1px solid rgba(18, 26, 46, 0.08);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transition: background 0.3s;
  }

  .nav-logo {
    font-family: "Syne", sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0;
    text-decoration: none;
    background: linear-gradient(130deg, #2647c2 0%, #2f83d6 45%, #00a3c4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    background: linear-gradient(130deg, #2647c2 0%, #2f83d6 45%, #00a3c4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.7;
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    opacity: 1;
  }

  .nav-links .cta-pill {
    padding: 7px 20px;
    border-radius: 100px;
    background: linear-gradient(130deg, #3457d1 0%, #0083a8 100%);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    transition: opacity 0.2s, transform 0.2s;
  }

  .nav-links .cta-pill:hover {
    opacity: 0.85;
    transform: scale(1.04);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 5px;
    background-color: transparent;
    background-image: linear-gradient(130deg, #2647c2 0%, #2f83d6 45%, #00a3c4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    border: none;
    padding: 0;
    font: inherit;
    color: #2f83d6;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .nav-dropdown-trigger:hover,
  .nav-dropdown-trigger[aria-current="page"],
  .nav-dropdown.is-open .nav-dropdown-trigger {
    opacity: 1;
  }

  .nav-dropdown-trigger .chevron {
    transition: transform 0.2s;
  }

  .nav-dropdown.is-open .chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 16px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 190px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: #fff;
    border: 1px solid rgba(18, 26, 46, 0.08);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(18, 26, 46, 0.14);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
  }

  .nav-dropdown.is-open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-menu a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 0.82rem;
    white-space: nowrap;
    color: rgba(18, 21, 28, 0.7);
  }

  .dropdown-menu a:hover,
  .dropdown-menu a[aria-current="page"] {
    color: #12151c;
    background: rgba(52, 87, 209, 0.08);
  }

  @media (max-width: 900px) {
    nav .nav-links li:not(:last-child) {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLLIElement>('.nav-dropdown').forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    if (!trigger) return;

    const close = () => {
      dropdown.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = dropdown.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(isOpen));
    });

    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        close();
        trigger.focus();
      }
    });
  });

  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLLIElement>('.nav-dropdown.is-open').forEach((dropdown) => {
      if (!dropdown.contains(event.target as Node)) {
        dropdown.classList.remove('is-open');
        dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
